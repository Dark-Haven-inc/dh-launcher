<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DarkHaven.Launcher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DarkHaven.ContentDb\DarkHaven.ContentDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="ZstdSharp.Port" />
    <PackageReference Include="SauceControl.Blake2Fast" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="Microsoft.Win32.Registry" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="DiscordRichPresence" />
  </ItemGroup>

  <!--
    The launch-proof signing key (Security/LaunchProof.cs). Release builds get it from the DH_LAUNCH_SIGNING_KEY CI
    secret through -p:DhLaunchKey=...; every other build gets an empty one and signs nothing. Never commit the key.
    The KeyGen source generator splits it into shares at compile time (LaunchSigningKey.LoadShares); DhLaunchKey is
    made visible to it below.
  -->
  <ItemGroup>
    <ProjectReference Include="..\DarkHaven.Launcher.KeyGen\DarkHaven.Launcher.KeyGen.csproj"
                     OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="DhLaunchKey" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DarkHaven.Launcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\signing_key" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\dh-regions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\news.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
