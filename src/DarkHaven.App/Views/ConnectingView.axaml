<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.ConnectingView"
             x:DataType="vm:ConnectingViewModel">
    <UserControl.Styles>
        <Style Selector="Border#Card">
            <Setter Property="Width" Value="400" />
        </Style>
        <!-- Stack traces are long; give them room instead of wrapping every frame twice. -->
        <Style Selector="Border#Card.wide">
            <Setter Property="Width" Value="600" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="Card" Classes.wide="{Binding HasLogTail}" Padding="16"
            Background="{StaticResource DhBgBrush}" BorderBrush="{StaticResource DhBorderStrongBrush}" BorderThickness="1"
            VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="12">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Subtitle}" Classes="lbl" />
                <TextBlock Text="{Binding Title}" Classes="name" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChecklistStepViewModel">
                        <Panel Height="24">
                            <Border Classes="hair" />
                            <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                <c:StatusGlyph Kind="{Binding GlyphKind}"
                                               Foreground="{Binding IsPending, Converter={x:Static vm:BoolBrush.DimText}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{Binding IsPending, Converter={x:Static vm:BoolBrush.DimText}}" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="mono dim" FontSize="10.5" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar VerticalAlignment="Bottom" Value="{Binding Fraction}" Minimum="0" Maximum="100"
                                         Background="Transparent" IsVisible="{Binding ShowBar}" />
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <SelectableTextBlock Text="{Binding ErrorText}" TextWrapping="Wrap"
                                 IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- What the client itself said before it died: selectable, so a line can be quoted. -->
            <StackPanel IsVisible="{Binding HasLogTail}">
                <Border Classes="cap"><TextBlock Classes="caps" Text="ВЫВОД ИГРЫ" /></Border>
                <ScrollViewer MaxHeight="200" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Text="{Binding LogTail}" Classes="mono" FontSize="10" TextWrapping="Wrap"
                                         Foreground="{StaticResource DhTextDimBrush}" />
                </ScrollViewer>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SpeedEta}" Classes="mono dim" FontSize="10.5"
                               IsVisible="{Binding SpeedEta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding BuildTag}" Classes="mono faint" FontSize="10" IsVisible="{Binding !IsBusy}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Отмена" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" IsCancel="True" />
                    <Button Content="{Binding CopyLabel}" Command="{Binding CopyLogCommand}" IsVisible="{Binding HasLogTail}" />
                    <Button Content="Логи" Command="{Binding OpenLogsCommand}" IsVisible="{Binding HasError}" />
                    <Button Content="Всё равно подключиться" Command="{Binding ConnectAnywayCommand}" IsVisible="{Binding CanConnectAnyway}" />
                    <Button Classes="primary" Content="ЕЩЁ РАЗ" Command="{Binding RetryCommand}" IsVisible="{Binding HasError}" />
                    <Button Content="Закрыть" Command="{Binding CloseCommand}" IsVisible="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
