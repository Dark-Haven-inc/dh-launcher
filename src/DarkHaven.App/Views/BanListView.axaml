<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:Class="DarkHaven.App.Views.BanListView"
             x:DataType="vm:BanListViewModel">

    <UserControl.Styles>
        <!-- Filter switches: same look as МОНИТОРИНГ's range switches -->
        <Style Selector="Button.pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DhBgHoverBrush}" />
        </Style>
        <Style Selector="Button.pill.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DhAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DhAccentBrush}" />
            <Setter Property="TextBlock.Foreground" Value="White" />
        </Style>
        <Style Selector="Border.state">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Background" Value="{StaticResource DhBgElevatedBrush}" />
        </Style>
        <Style Selector="Border.state.active">
            <Setter Property="Background" Value="{StaticResource DhDangerBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="28,24">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,14,*,Auto">
            <Button Classes="ghost" Content="← Назад" Command="{Binding BackCommand}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Classes="h1" Text="{Binding Title}" />
                <TextBlock Classes="dim" Text="Кто, за что, когда, на сколько и кем. Скрытые баны сюда не попадают." />
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding TotalText}" Classes="dim" VerticalAlignment="Center" />
        </Grid>

        <!-- Search and filters -->
        <TextBox DockPanel.Dock="Top" Margin="0,16,0,0" Watermark="Поиск по нику игрока…" Text="{Binding Search}" />
        <WrapPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <Button Classes="pill" Margin="0,0,6,6" Content="Все" Command="{Binding SetStatusCommand}" CommandParameter="all"
                    Classes.selected="{Binding Status, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=all}" />
            <Button Classes="pill" Margin="0,0,6,6" Content="Действуют" Command="{Binding SetStatusCommand}" CommandParameter="active"
                    Classes.selected="{Binding Status, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=active}" />
            <Button Classes="pill" Margin="0,0,6,6" Content="Истекли" Command="{Binding SetStatusCommand}" CommandParameter="expired"
                    Classes.selected="{Binding Status, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=expired}" />
            <Button Classes="pill" Margin="0,0,18,6" Content="Сняты" Command="{Binding SetStatusCommand}" CommandParameter="lifted"
                    Classes.selected="{Binding Status, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=lifted}" />
            <Button Classes="pill" Margin="0,0,6,6" Content="Любые" Command="{Binding SetTypeCommand}" CommandParameter="all"
                    Classes.selected="{Binding Type, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=all}" />
            <Button Classes="pill" Margin="0,0,6,6" Content="На сервере" Command="{Binding SetTypeCommand}" CommandParameter="server"
                    Classes.selected="{Binding Type, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=server}" />
            <Button Classes="pill" Margin="0,0,6,6" Content="На роли" Command="{Binding SetTypeCommand}" CommandParameter="role"
                    Classes.selected="{Binding Type, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=role}" />
        </WrapPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Выданы с" Classes="dim" VerticalAlignment="Center" />
            <CalendarDatePicker SelectedDate="{Binding From}" Watermark="любой даты" />
            <TextBlock Text="по" Classes="dim" VerticalAlignment="Center" />
            <CalendarDatePicker SelectedDate="{Binding To}" Watermark="сегодня" />
            <Button Classes="ghost" Content="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" />
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" Margin="0,10,0,0"
                     IsVisible="{Binding IsLoading}" Foreground="{StaticResource DhAccentBrush}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Classes="dim" Margin="0,12,0,0" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- The list -->
        <ScrollViewer Margin="0,12,0,0">
            <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BanRowViewModel">
                            <Border Classes="card" Padding="14,12">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="{Binding Player}" FontWeight="Bold" FontSize="15" />
                                    <Border Grid.Row="0" Grid.Column="1" Classes="state" Classes.active="{Binding IsActive}">
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="dim" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                                        <Run Text="{Binding WhenText}" /><Run Text=" · " /><Run Text="{Binding DurationText}" />
                                        <Run Text=" · " /><Run Text="{Binding KindText}" />
                                        <Run Text="{Binding AdminText, StringFormat=' · {0}'}" />
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="ghost" HorizontalAlignment="Center" Content="Показать ещё"
                        Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" IsEnabled="{Binding !IsLoading}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
