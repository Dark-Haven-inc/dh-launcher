<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:Class="DarkHaven.App.Views.NotificationsPanel"
             x:DataType="vm:NotificationsViewModel"
             Width="360">

    <UserControl.Styles>
        <Style Selector="TextBlock.kind">
            <Setter Property="Foreground" Value="{StaticResource DhAccentBrightBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
        </Style>
        <Style Selector="TextBlock.kind.warning">
            <Setter Property="Foreground" Value="{StaticResource DhWarnBrush}" />
        </Style>
        <Style Selector="TextBlock.kind.ban">
            <Setter Property="Foreground" Value="{StaticResource DhDangerBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12,10,10">
            <TextBlock Text="УВЕДОМЛЕНИЯ" Classes="caps" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Content="Прочитать все" Padding="8,3" FontSize="11"
                    Command="{Binding MarkAllReadCommand}" IsVisible="{Binding HasUnread}" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DhBorderBrush}" />

        <Panel>
            <TextBlock Text="Новых уведомлений нет" Classes="dim" Margin="16,18"
                       IsVisible="{Binding IsEmpty}" />

            <ScrollViewer MaxHeight="380" IsVisible="{Binding HasUnread}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationItemViewModel">
                            <Border BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="16,10,10,12">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding KindLabel}" Classes="kind"
                                                   Classes.ban="{Binding IsBan}" Classes.warning="{Binding IsWarning}" />
                                        <TextBlock Text="{Binding When}" Classes="dim" FontSize="10" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Text}" TextWrapping="Wrap"
                                               Margin="0,5,10,0" FontSize="12" />
                                    <Button Grid.Column="1" Grid.RowSpan="2" Classes="ghost" Content="✓"
                                            Padding="8,2" VerticalAlignment="Top" ToolTip.Tip="Прочитано"
                                            Command="{Binding $parent[ItemsControl].((vm:NotificationsViewModel)DataContext).MarkReadCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
