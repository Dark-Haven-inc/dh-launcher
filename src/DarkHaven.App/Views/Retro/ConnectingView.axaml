<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.Retro.ConnectingView"
             x:DataType="vm:ConnectingViewModel">
    <UserControl.Styles>
        <Style Selector="HeaderedContentControl#Card">
            <Setter Property="Width" Value="440" />
        </Style>
        <!-- Stack traces are long; give them room instead of wrapping every frame twice. -->
        <Style Selector="HeaderedContentControl#Card.wide">
            <Setter Property="Width" Value="640" />
        </Style>
    </UserControl.Styles>

    <!-- Connecting as a text-mode dialog: the steps as a checklist with block progress bars. -->
    <HeaderedContentControl x:Name="Card" Classes="box double" Classes.wide="{Binding HasLogTail}" Header="{Binding Subtitle}"
                            Padding="14,14,14,12" Background="{StaticResource DhBgBrush}"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />

            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChecklistStepViewModel">
                        <StackPanel Spacing="2" Margin="0,2">
                            <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="10">
                                <c:StatusGlyph Kind="{Binding GlyphKind}" VerticalAlignment="Center"
                                               Foreground="{Binding IsPending, Converter={x:Static vm:BoolBrush.DimText}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                           Foreground="{Binding IsPending, Converter={x:Static vm:BoolBrush.DimText}}" />
                                <TextBlock Grid.Column="2" Classes="key" Text="{Binding Detail}" VerticalAlignment="Center" />
                            </Grid>
                            <ProgressBar Classes="blocks" Margin="18,0,0,0" Value="{Binding Fraction}" Minimum="0" Maximum="100"
                                         IsVisible="{Binding ShowBar}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <SelectableTextBlock Text="{Binding ErrorText, Converter={x:Static vm:Lowercase.Instance}}" TextWrapping="Wrap"
                                 IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <!-- What the client itself said before it died: selectable, so a line can be quoted. -->
            <HeaderedContentControl Classes="box" Header="ВЫВОД ИГРЫ" Padding="8,8,4,6" IsVisible="{Binding HasLogTail}">
                <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
                    <SelectableTextBlock Text="{Binding LogTail}" FontSize="10.5" TextWrapping="Wrap"
                                         Foreground="{StaticResource DhTextDimBrush}" />
                </ScrollViewer>
            </HeaderedContentControl>

            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SpeedEta}" Classes="key"
                               IsVisible="{Binding SpeedEta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding BuildTag}" Classes="faint" FontSize="10.5" IsVisible="{Binding !IsBusy}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" ItemSpacing="4" HorizontalAlignment="Right">
                    <Button Content="отмена" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" IsCancel="True" />
                    <Button Content="{Binding CopyLabel, Converter={x:Static vm:Lowercase.Instance}}" Command="{Binding CopyLogCommand}" IsVisible="{Binding HasLogTail}" />
                    <Button Content="логи" Command="{Binding OpenLogsCommand}" IsVisible="{Binding HasError}" />
                    <Button Content="всё равно подключиться" Command="{Binding ConnectAnywayCommand}" IsVisible="{Binding CanConnectAnyway}" />
                    <Button Classes="primary" Content="ЕЩЁ РАЗ" Command="{Binding RetryCommand}" IsVisible="{Binding HasError}" />
                    <Button Content="закрыть" Command="{Binding CloseCommand}" IsVisible="{Binding !IsBusy}" />
                </WrapPanel>
            </Grid>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
