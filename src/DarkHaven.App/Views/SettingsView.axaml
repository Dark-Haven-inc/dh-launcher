<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:Class="DarkHaven.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="18" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="Settings" />

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <CheckBox Content="Compatibility rendering mode (GLES2)" IsChecked="{Binding CompatMode}" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Dark Haven regions list URL (optional)" Classes="dim" />
                        <TextBox Watermark="https://…/dh-regions.json" Text="{Binding RegionsUrl}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Storage" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DataDir}" Classes="dim" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="nav" Content="Open folder" Command="{Binding OpenDataDirCommand}" />
                        <Button Classes="nav" Content="Clear downloaded content" Command="{Binding ClearContentCacheCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Classes="dim"
                               IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
