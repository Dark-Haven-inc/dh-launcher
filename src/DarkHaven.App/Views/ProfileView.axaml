<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:views="using:DarkHaven.App.Views"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <UserControl.Styles>
        <!-- Colour swatches in the editor -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBgBrush}" />
        </Style>
        <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource DhTextDimBrush}" />
        </Style>
        <Style Selector="Button.swatch.selected /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource DhTextBrush}" />
        </Style>
        <Style Selector="Border.rule">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource DhBorderBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <Grid Margin="20,16" ColumnDefinitions="320,24,*" MaxWidth="1040" HorizontalAlignment="Stretch">

            <!-- Left: the card — and, while editing, its live preview -->
            <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Top">
                <views:ProfileCard />

                <Button Classes="primary" Content="изменить профиль" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Command="{Binding EditCommand}"
                        IsVisible="{Binding !IsEditing}" />
                <Button Content="аккаунты" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Command="{Binding ManageAccountsCommand}"
                        IsVisible="{Binding !IsEditing}" />

                <!-- Local look exists, the platform has none: friends see a blank card -->
                <Border Classes="card" Padding="12,8">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="NeedsSync" />
                            <Binding Path="!IsEditing" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Classes="dim" Text="профиль виден только вам — сохраните его" />
                </Border>
            </StackPanel>

            <!-- Right: everything else… -->
            <StackPanel Grid.Column="2" Spacing="16" IsVisible="{Binding !IsEditing}">

                <!-- Launcher ban banner (server-authoritative, only known once the platform answers) -->
                <Border Classes="card" Padding="12,8" IsVisible="{Binding LauncherBanned}" BorderBrush="{StaticResource DhTextBrush}">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:StatusGlyph Kind="off" />
                            <TextBlock Text="ДОСТУП ОГРАНИЧЕН" Classes="caps" Foreground="{StaticResource DhTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding LauncherBanText, Converter={x:Static vm:Lowercase.Instance}}" Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Stats -->
                <Border Height="52" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Margin="12,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding TotalPlaytime}" Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="наиграно" Classes="dim" FontSize="10.5" />
                        </StackPanel>
                        <Border Grid.Column="1" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1,0,0,0" Padding="12,0">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding FavoritesCount}" Classes="mono" FontSize="12" />
                                <TextBlock Text="в избранном" Classes="dim" FontSize="10.5" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1,0,0,0" Padding="12,0">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding RecentCount}" Classes="mono" FontSize="12" />
                                <TextBlock Text="недавних" Classes="dim" FontSize="10.5" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Characters from the game DB, with Frontier bank balance (platform only) -->
                <StackPanel IsVisible="{Binding IsPlatformConnected}">
                    <Border Classes="cap"><TextBlock Text="ПЕРСОНАЖИ" Classes="caps" /></Border>
                    <TextBlock Text="{Binding CharactersNote, Converter={x:Static vm:Lowercase.Instance}}" Classes="dim" TextWrapping="Wrap"
                               IsVisible="{Binding CharactersNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl ItemsSource="{Binding Characters}" IsVisible="{Binding HasCharacters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CharacterRowViewModel">
                                <Border Classes="hair" Height="28">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                        <c:StatusGlyph Kind="on" IsVisible="{Binding Selected}" ToolTip.Tip="выбран" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Slot}" Classes="mono dim" FontSize="10.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Balance}" Classes="mono" FontSize="11.5" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Per-server playtime -->
                <StackPanel IsVisible="{Binding !NoPlaytime}">
                    <Border Classes="cap"><TextBlock Text="ВРЕМЯ ПО СЕРВЕРАМ" Classes="caps" /></Border>
                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlaytimeRowViewModel">
                                <Panel Height="28">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Sessions}" Classes="mono dim" FontSize="10.5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Hours}" Classes="mono" FontSize="11.5" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding BarFraction}" VerticalAlignment="Bottom" />
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Discord account link -->
                <StackPanel IsVisible="{Binding IsPlatformConnected}">
                    <Border Classes="cap"><TextBlock Text="DISCORD" Classes="caps" /></Border>
                    <Border Padding="0,8">
                        <StackPanel Spacing="8">
                            <!-- Linked -->
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding DiscordLinkedName, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding DiscordLinkedName}" />
                                <Button Grid.Column="1" Content="отвязать" Command="{Binding UnlinkDiscordCommand}" />
                            </Grid>
                            <!-- Not linked -->
                            <Button HorizontalAlignment="Left" Content="привязать"
                                    IsVisible="{Binding DiscordLinkedName, Converter={x:Static ObjectConverters.IsNull}}"
                                    Command="{Binding RequestDiscordLinkCommand}" IsEnabled="{Binding !DiscordLinkRequesting}" />
                            <TextBlock Text="{Binding DiscordStatus, Converter={x:Static vm:Lowercase.Instance}}" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding DiscordStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <StackPanel Spacing="2" IsVisible="{Binding DiscordLinkCode, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Classes="dim" Text="боту «Дозорный» в Discord:" />
                                <SelectableTextBlock Classes="mono" FontSize="16">
                                    <Run Text="!link " /><Run Text="{Binding DiscordLinkCode}" />
                                </SelectableTextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>

            <!-- …or the editor, with the card on the left as its live preview -->
            <StackPanel Grid.Column="2" Spacing="16" IsVisible="{Binding IsEditing}" MaxWidth="560"
                        HorizontalAlignment="Left">
                <!-- Actions up top, always in view — the form is taller than the window -->
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="ПРОФИЛЬ" Classes="caps" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button Content="отмена" Command="{Binding CancelEditCommand}"
                                    IsEnabled="{Binding !IsSaving}" />
                            <Button Classes="primary" Content="{Binding SaveLabel, Converter={x:Static vm:Lowercase.Instance}}" Command="{Binding SaveProfileCommand}"
                                    IsEnabled="{Binding !IsSaving}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SaveError, Converter={x:Static vm:Lowercase.Instance}}" Foreground="{StaticResource DhDangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding HasSaveError}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="АВАТАР" Classes="caps" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="сменить аватар" Name="PickAvatarButton" />
                        <Button Content="убрать" Command="{Binding RemoveAvatarCommand}"
                                IsVisible="{Binding HasAvatar}" />
                    </StackPanel>
                </StackPanel>

                <Border Classes="rule" />

                <StackPanel Spacing="8">
                    <TextBlock Text="БАННЕР" Classes="caps" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="загрузить баннер" Name="PickBannerButton" />
                        <Button Content="убрать" Command="{Binding RemoveBannerCommand}"
                                IsVisible="{Binding HasBanner}" />
                    </StackPanel>
                    <TextBlock Classes="mono dim" FontSize="10.5" Text="3:1, например 960×320" />
                </StackPanel>

                <Border Classes="rule" />

                <StackPanel Spacing="8">
                    <TextBlock Text="ЦВЕТ ПРОФИЛЯ" Classes="caps" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ItemsControl ItemsSource="{Binding AccentChoices}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccentChoice">
                                    <Button Classes="swatch" Classes.selected="{Binding IsSelected}"
                                            Background="{Binding Brush}" ToolTip.Tip="{Binding Hex}"
                                            Command="{Binding $parent[ItemsControl].((vm:ProfileViewModel)DataContext).SetAccentCommand}"
                                            CommandParameter="{Binding Hex}">
                                        <TextBlock Text="&#xEAB2;" FontFamily="{StaticResource DhMono}" FontSize="12" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsSelected}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding AccentColor}" Width="96" MaxLength="7" VerticalAlignment="Center"
                                 FontFamily="{StaticResource DhMono}" />
                    </StackPanel>
                </StackPanel>

                <Border Classes="rule" />

                <StackPanel Spacing="8">
                    <TextBlock Text="РАМКА АВАТАРА" Classes="caps" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="chip" Content="синяя" Command="{Binding SetFrameCommand}" CommandParameter="blue"
                                Classes.on="{Binding Frame, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=blue}" />
                        <Button Classes="chip" Content="золотая" Command="{Binding SetFrameCommand}" CommandParameter="gold"
                                Classes.on="{Binding Frame, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=gold}" />
                        <Button Classes="chip" Content="циан" Command="{Binding SetFrameCommand}" CommandParameter="cyan"
                                Classes.on="{Binding Frame, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=cyan}" />
                        <Button Classes="chip" Content="без рамки" Command="{Binding SetFrameCommand}" CommandParameter="none"
                                Classes.on="{Binding Frame, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=none}" />
                    </StackPanel>
                </StackPanel>

                <Border Classes="rule" />

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="О СЕБЕ" Classes="caps" />
                        <TextBlock Grid.Column="1" Text="{Binding AboutCounter}" Classes="dim" FontSize="11" />
                    </Grid>
                    <TextBox Text="{Binding AboutMe}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="190"
                             Height="92" />
                </StackPanel>

                <TextBlock Classes="dim" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !IsPlatformConnected}"
                           Text="нет связи с платформой — профиль сохранится только здесь" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
