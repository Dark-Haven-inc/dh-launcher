<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:Class="DarkHaven.App.Views.NotificationsPanel"
             x:DataType="vm:NotificationsViewModel"
             Width="320">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Padding="12,0" Classes="hair">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="УВЕДОМЛЕНИЯ" Classes="caps" />
                <Button Grid.Column="1" Classes="link" Content="прочитать все" Command="{Binding MarkAllReadCommand}"
                        IsVisible="{Binding HasUnread}" />
            </Grid>
        </Border>
        <Panel>
            <TextBlock Text="нет уведомлений" Classes="dim" Margin="12" IsVisible="{Binding IsEmpty}" />
            <ScrollViewer MaxHeight="360" IsVisible="{Binding HasUnread}">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NotificationItemViewModel">
                            <Border Classes="hair" Padding="12,8,4,8">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding KindLabel}" Classes="lbl" Foreground="{StaticResource DhTextBrush}" />
                                        <TextBlock Text="{Binding When}" Classes="mono dim" FontSize="10" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,8,0" />
                                    <Button Grid.Column="1" Grid.RowSpan="2" Classes="link icon mini" Content="&#xEAB2;"
                                            VerticalAlignment="Top" ToolTip.Tip="прочитано"
                                            Command="{Binding $parent[ItemsControl].((vm:NotificationsViewModel)DataContext).MarkReadCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
