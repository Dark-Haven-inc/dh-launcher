<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.RegionsView"
             x:DataType="vm:RegionsViewModel">
    <Grid ColumnDefinitions="*,272">
        <!-- The sector map -->
        <Panel Grid.Column="0">
            <c:FlatMap x:Name="Map" ItemsSource="{Binding Nodes}" SelectedItem="{Binding Selected}" />
            <TextBlock Classes="mono dim" FontSize="10" Margin="16,12" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Run Text="в сети " /><Run Text="{Binding TotalPlayers}" />
            </TextBlock>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding Error, Converter={x:Static vm:Lowercase.Instance}}" Classes="dim" TextWrapping="Wrap" Margin="16,12" VerticalAlignment="Bottom"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Panel>

        <!-- The selected region -->
        <Border Grid.Column="1" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1,0,0,0" Padding="16">
            <ScrollViewer IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="name" Text="{Binding Selected.Name}" TextWrapping="Wrap" />
                        <TextBlock Classes="mono dim" FontSize="10.5" Text="{Binding Selected.Address}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Border Classes="hair" Height="24">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Classes="dim" Text="состояние" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <c:StatusGlyph IsOnline="{Binding Selected.IsOnline}" IsOffline="{Binding Selected.IsOffline}"
                                                       IsQuarantine="{Binding Selected.IsQuarantine}" IsFull="{Binding Selected.IsFull}" />
                                        <TextBlock Text="{Binding Selected.StateText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="hair" Height="24" IsVisible="{Binding Selected.IsOnline}">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Classes="dim" Text="игроков" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding Selected.Population}" />
                                </Grid>
                            </Border>
                            <Border Classes="hair" Height="24" IsVisible="{Binding Selected.IsOnline}">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Classes="dim" Text="раунд" />
                                    <TextBlock Grid.Column="1" Text="{Binding Selected.RoundText}" />
                                </Grid>
                            </Border>
                            <Border Classes="hair" Height="24" IsVisible="{Binding !Selected.IsQuarantine}">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Classes="dim" Text="отклик" />
                                    <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding Selected.Ping}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8" IsVisible="{Binding !Selected.IsQuarantine}">
                        <Button Classes="primary" Height="28" HorizontalAlignment="Stretch" Command="{Binding PlaySelectedCommand}"
                                IsEnabled="{Binding Selected.CanConnect}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="&#xEB2C;" FontSize="11" />
                                <TextBlock Text="ИГРАТЬ" LetterSpacing="1.8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="{Binding Selected.SlotLabel, Converter={x:Static vm:Lowercase.Instance}}" Command="{Binding Selected.WaitForSlotCommand}"
                                IsVisible="{Binding Selected.CanWaitForSlot}" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="{Binding Selected.WatchLabel, Converter={x:Static vm:Lowercase.Instance}}" Command="{Binding Selected.ToggleWatchCommand}"
                                IsVisible="{Binding Selected.CanWatch}" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="баны игроков" Command="{Binding ShowBansCommand}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding HasNeighbours}">
                        <Border Classes="cap">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caps" Text="СОСЕДИ" />
                                <TextBlock Grid.Column="1" Classes="caps" Text="{Binding SelectedNeighbours.Count}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding SelectedNeighbours}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RegionNodeViewModel">
                                    <Button Classes="row" Command="{Binding SelectCommand}"
                                            Foreground="{Binding IsOnline, Converter={x:Static vm:BoolBrush.TextOrDim}}">
                                        <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="8">
                                            <c:StatusGlyph IsOnline="{Binding IsOnline}" IsOffline="{Binding IsOffline}"
                                                           IsQuarantine="{Binding IsQuarantine}" IsFull="{Binding IsFull}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="mono" FontSize="10.5" Text="{Binding Population}"
                                                       Foreground="{Binding $parent[Button].Foreground}"
                                                       IsVisible="{Binding IsOnline}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
