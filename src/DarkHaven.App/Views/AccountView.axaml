<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:Class="DarkHaven.App.Views.AccountView"
             x:DataType="vm:AccountViewModel">

    <ScrollViewer>
        <StackPanel Margin="0,32" Spacing="16" MaxWidth="420" HorizontalAlignment="Center">

            <StackPanel Spacing="2" HorizontalAlignment="Center">
                <Image Source="/Assets/emblem.png" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="ВХОД В СЕТЬ" Classes="h1" HorizontalAlignment="Center" LetterSpacing="2" />
                <TextBlock Text="Аккаунт Space Station 14 для всех регионов Dark Haven"
                           Classes="dim" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>

            <Border Classes="card" Padding="22">
                <StackPanel Spacing="10">
                    <TextBlock Text="ЛОГИН" Classes="caps" />
                    <TextBox Text="{Binding Username}" />
                    <TextBlock Text="ПАРОЛЬ" Classes="caps" Margin="0,4,0,0" />
                    <TextBox Text="{Binding Password}" PasswordChar="•" />
                    <StackPanel IsVisible="{Binding NeedsTfa}" Spacing="6">
                        <TextBlock Text="КОД 2FA" Classes="caps" Margin="0,4,0,0" />
                        <TextBox Text="{Binding TfaCode}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DhDangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Classes="primary" Content="ВОЙТИ" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                            Command="{Binding LoginCommand}" IsEnabled="{Binding !Busy}" />
                    <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                        <Button Grid.Column="0" Classes="ghost" BorderThickness="0" HorizontalAlignment="Left"
                                Content="Создать аккаунт" Command="{Binding OpenRegisterCommand}" />
                        <Button Grid.Column="1" Classes="ghost" BorderThickness="0" HorizontalAlignment="Right"
                                Content="Забыли пароль?" Command="{Binding OpenForgotCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8" IsVisible="{Binding Accounts.Count}">
                <TextBlock Text="СОХРАНЁННЫЕ АККАУНТЫ" Classes="caps" />
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccountRowViewModel">
                            <Border Background="{StaticResource DhBgElevatedBrush}" BorderThickness="2,0,0,0"
                                    BorderBrush="{StaticResource DhAccentBrush}" CornerRadius="0,5,5,0" Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusHint}" Classes="dim" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" BorderThickness="0" Content="Выбрать"
                                            Command="{Binding $parent[ItemsControl].((vm:AccountViewModel)DataContext).SetActiveCommand}"
                                            CommandParameter="{Binding}" IsVisible="{Binding !IsActive}" />
                                    <Button Grid.Column="2" Classes="ghost" BorderThickness="0" Content="Выйти"
                                            Command="{Binding $parent[ItemsControl].((vm:AccountViewModel)DataContext).LogoutCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Classes="dim mono" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Text="{Binding AuthServerLine}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
