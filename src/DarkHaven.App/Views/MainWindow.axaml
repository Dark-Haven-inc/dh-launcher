<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DarkHaven.App.ViewModels"
        xmlns:views="using:DarkHaven.App.Views"
        x:Class="DarkHaven.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Dark Haven Launcher" Width="1100" Height="720"
        MinWidth="960" MinHeight="600"
        Icon="/Assets/icon.ico"
        Background="{StaticResource DhBgBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="vm:RegionsViewModel"><views:RegionsView /></DataTemplate>
        <DataTemplate DataType="vm:ServerListViewModel"><views:ServerListView /></DataTemplate>
        <DataTemplate DataType="vm:NewsViewModel"><views:PlaceholderView /></DataTemplate>
        <DataTemplate DataType="vm:AdminViewModel"><views:PlaceholderView /></DataTemplate>
        <DataTemplate DataType="vm:AccountViewModel"><views:AccountView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:ConnectingViewModel"><views:ConnectingView /></DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <DockPanel>
            <!-- Top bar -->
            <Border DockPanel.Dock="Top" Background="{StaticResource DhBgElevatedBrush}"
                    BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,0,0,1" Height="58">
                <Grid Margin="20,0" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Image Source="/Assets/emblem.png" Width="32" Height="32" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DARK HAVEN" FontWeight="Bold" FontSize="15" LetterSpacing="1"
                                       Foreground="{StaticResource DhTextBrush}" />
                            <TextBlock Text="СЕТЬ СТАНЦИЙ" Classes="caps" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ghost" Content="Discord" Command="{Binding OpenDiscordCommand}" />
                        <Button Classes="ghost" Content="Сайт" Command="{Binding OpenSiteCommand}" />
                        <Button Classes="ghost" Command="{Binding OpenAccountCommand}">
                            <TextBlock>
                                <Run Text="{Binding AccountName, FallbackValue='Гость'}" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Self-update banner -->
            <Border DockPanel.Dock="Top" Background="{StaticResource DhAccentBrush}" Padding="20,8"
                    IsVisible="{Binding ShowUpdateBanner}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding UpdateBannerText}" Foreground="White"
                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Обновить" Command="{Binding StartUpdateCommand}"
                                IsVisible="{Binding CanStartUpdate}"
                                Background="White" Foreground="{StaticResource DhAccent}" Padding="12,4" FontSize="12" />
                        <Button Content="Перезапустить" Command="{Binding RestartForUpdateCommand}"
                                IsVisible="{Binding CanRestartForUpdate}"
                                Background="White" Foreground="{StaticResource DhAccent}" Padding="12,4" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom tab bar -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource DhBgElevatedBrush}"
                    BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,1,0,0" Height="52">
                <Grid Margin="20,0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding VersionLine}" Classes="mono dim"
                               VerticalAlignment="Center" FontSize="10" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="tab" Content="ГЛАВНАЯ" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:NavPage.Home}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Home}}" />
                        <Button Classes="tab" Content="РЕГИОНЫ" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:NavPage.Regions}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Regions}}" />
                        <Button Classes="tab" Content="СЕРВЕРЫ" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:NavPage.Servers}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Servers}}" />
                        <Button Classes="tab" Content="НОВОСТИ" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:NavPage.News}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.News}}" />
                        <Button Classes="tab" Content="НАСТРОЙКИ" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:NavPage.Settings}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Settings}}" />
                        <Button Classes="tab" Content="АДМИН" Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:NavPage.Admin}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Admin}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Content="{Binding Current}" />
        </DockPanel>

        <!-- Connecting overlay -->
        <Border IsVisible="{Binding Connecting, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#D8060A12">
            <ContentControl Content="{Binding Connecting}" />
        </Border>
    </Panel>
</Window>
