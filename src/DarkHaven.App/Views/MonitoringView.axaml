<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.MonitoringView"
             x:DataType="vm:MonitoringViewModel">

    <UserControl.Styles>
        <Style Selector="Border.cell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <Style Selector="Border.cell TextBlock.v">
            <Setter Property="FontFamily" Value="{StaticResource DhMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.cell TextBlock.k, StackPanel.sum TextBlock.k">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        </Style>
        <Style Selector="StackPanel.sum TextBlock.v">
            <Setter Property="FontFamily" Value="{StaticResource DhMono}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Border.lcell">
            <Setter Property="Height" Value="36" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="c|OnlineChart.loading">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="20,16" Spacing="16">
            <TextBlock Classes="dim" IsVisible="{Binding !HasRegions}" Text="Регионов нет" />

            <!-- Region switch -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasRegions}">
                <ItemsControl ItemsSource="{Binding Regions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MonitorRegion">
                            <Button Classes="chip" Classes.on="{Binding IsSelected}" Content="{Binding Name}"
                                    Command="{Binding $parent[ItemsControl].((vm:MonitoringViewModel)DataContext).SelectRegionCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="1" Classes="icon" Content="&#xEB37;" ToolTip.Tip="Обновить" Command="{Binding RefreshCommand}" />
            </Grid>

            <!-- Right now -->
            <Border Height="52" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1" Margin="0,-8,0,0"
                    IsVisible="{Binding HasRegions}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,128">
                    <StackPanel Margin="12,0" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:StatusGlyph IsOnline="{Binding IsOnline}" IsOffline="{Binding !IsOnline}" />
                            <TextBlock Classes="mono" FontSize="12" Text="{Binding StateText}" />
                        </StackPanel>
                        <Button Classes="link" Command="{Binding CopyAddressCommand}" HorizontalAlignment="Left" ToolTip.Tip="Скопировать адрес">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="mono" FontSize="10.5" Text="{Binding Selected.Address}" Foreground="{Binding $parent[Button].Foreground}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="icon" FontSize="10" Text="{Binding CopyLabel}" Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="cell" Width="88">
                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Classes="v" Text="{Binding PlayersText}" /><TextBlock Classes="k" Text="онлайн" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="cell" Width="104">
                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Classes="v" Text="{Binding MapText}" /><TextBlock Classes="k" Text="карта" /></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="cell" Width="96">
                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Classes="v" Text="{Binding PresetText}" /><TextBlock Classes="k" Text="режим" /></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Classes="cell" Width="72">
                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Classes="v" Text="{Binding RoundText}" /><TextBlock Classes="k" Text="раунд" /></StackPanel>
                    </Border>
                    <Border Grid.Column="5" Classes="cell" Width="72">
                        <StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Classes="v" Text="{Binding PingText}" /><TextBlock Classes="k" Text="пинг" /></StackPanel>
                    </Border>
                    <Button Grid.Column="6" Classes="primary" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                            Command="{Binding PlayCommand}" IsEnabled="{Binding IsOnline}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xEB2C;" FontSize="11" />
                            <TextBlock Text="ИГРАТЬ" LetterSpacing="1.8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- History -->
            <StackPanel Spacing="8" IsVisible="{Binding HasRegions}">
                <Border Classes="cap">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="caps" Text="ОНЛАЙН" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Classes="chip" Content="24 ч" Command="{Binding SetRangeCommand}" CommandParameter="24h"
                                    Classes.on="{Binding Range, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=24h}" />
                            <Button Classes="chip" Content="7 дней" Command="{Binding SetRangeCommand}" CommandParameter="7d" Margin="-1,0,0,0"
                                    Classes.on="{Binding Range, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=7d}" />
                            <Button Classes="chip" Content="месяц" Command="{Binding SetRangeCommand}" CommandParameter="30d" Margin="-1,0,0,0"
                                    Classes.on="{Binding Range, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=30d}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <c:OnlineChart Height="152" Points="{Binding Points}" Capacity="{Binding Capacity}"
                               Range="{Binding Range}" EmptyText="{Binding EmptyText}" Classes.loading="{Binding IsLoading}" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Classes="sum" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="k" Text="пик" /><TextBlock Classes="v" Text="{Binding PeakText}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="k" Text="в среднем" /><TextBlock Classes="v" Text="{Binding AverageText}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Classes="k" Text="доступность" /><TextBlock Classes="v" Text="{Binding UptimeText}" /></StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding ToggleTableCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xEB84;" FontSize="11" />
                            <TextBlock Text="{Binding TableLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel IsVisible="{Binding ShowTable}">
                    <Border Classes="cap">
                        <Grid ColumnDefinitions="180,96,96,*">
                            <TextBlock Classes="caps" Text="ВРЕМЯ" />
                            <TextBlock Grid.Column="1" Classes="caps" Text="СРЕДНЕЕ" />
                            <TextBlock Grid.Column="2" Classes="caps" Text="ПИК" />
                            <TextBlock Grid.Column="3" Classes="caps" Text="ДОСТУПЕН" />
                        </Grid>
                    </Border>
                    <ScrollViewer MaxHeight="240">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryRow">
                                    <Border Classes="hair" Height="24">
                                        <Grid ColumnDefinitions="180,96,96,*" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding When}" Classes="dim" />
                                            <TextBlock Grid.Column="1" Text="{Binding Average}" Classes="mono" />
                                            <TextBlock Grid.Column="2" Text="{Binding Peak}" Classes="mono" />
                                            <TextBlock Grid.Column="3" Text="{Binding Uptime}" Classes="mono" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            <!-- The launcher itself: counted from the presence heartbeat every copy already sends -->
            <StackPanel Spacing="8" IsVisible="{Binding HasLauncherStats}">
                <Border Classes="cap"><TextBlock Classes="caps" Text="ЛАУНЧЕР" /></Border>
                <Grid ColumnDefinitions="240,*" ColumnSpacing="20">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" VerticalAlignment="Top">
                        <Border Classes="lcell">
                            <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Classes="mono" FontSize="12" Text="{Binding LauncherNowText}" /><TextBlock Classes="dim" FontSize="10.5" Text="сейчас" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="lcell" Padding="12,0,0,0" BorderThickness="1,0,0,1">
                            <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Classes="mono" FontSize="12" Text="{Binding LauncherInGameText}" /><TextBlock Classes="dim" FontSize="10.5" Text="в игре" /></StackPanel>
                        </Border>
                        <Border Grid.Row="1" Classes="lcell">
                            <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Classes="mono" FontSize="12" Text="{Binding LauncherPeakDayText}" /><TextBlock Classes="dim" FontSize="10.5" Text="пик за сутки" /></StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Classes="lcell" Padding="12,0,0,0" BorderThickness="1,0,0,1">
                            <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Classes="mono" FontSize="12" Text="{Binding LauncherPeakEverText}" /><TextBlock Classes="dim" FontSize="10.5" Text="рекорд" /></StackPanel>
                        </Border>
                    </Grid>
                    <c:OnlineChart Grid.Column="1" Height="96" Points="{Binding LauncherPoints}" Range="{Binding Range}"
                                   EmptyText="Нет данных" Classes.loading="{Binding IsLoading}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding LauncherRegions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LauncherRegionRow">
                            <TextBlock Text="{Binding Text}" Classes="mono dim" FontSize="10.5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
