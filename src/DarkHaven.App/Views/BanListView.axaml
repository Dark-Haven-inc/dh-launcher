<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.BanListView"
             x:DataType="vm:BanListViewModel">

    <UserControl.Styles>
        <Style Selector="Border.sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="{StaticResource DhBorderStrongBrush}" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{StaticResource DhBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderStrongBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20,16">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Classes="icon" Content="&#xEA9B;" ToolTip.Tip="Назад" Command="{Binding BackCommand}" />
            <TextBlock Grid.Column="1" Classes="name" Text="{Binding Title}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding TotalText}" Classes="mono dim" VerticalAlignment="Center" />
        </Grid>

        <!-- Search and filters -->
        <Grid DockPanel.Dock="Top" Margin="0,16,0,0">
            <TextBox Watermark="Поиск по нику" Text="{Binding Search}" Padding="28,4,8,4" />
            <TextBlock Classes="icon dim" Text="&#xEA6D;" FontSize="11" Margin="10,0,0,0" IsHitTestVisible="False" />
        </Grid>
        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0" ItemSpacing="8" LineSpacing="8">
            <StackPanel Orientation="Horizontal">
                <Button Classes="chip" Content="все" Command="{Binding SetStatusCommand}" CommandParameter="all"
                        Classes.on="{Binding Status, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=all}" />
                <Button Classes="chip" Content="действуют" Margin="-1,0,0,0" Command="{Binding SetStatusCommand}" CommandParameter="active"
                        Classes.on="{Binding Status, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=active}" />
                <Button Classes="chip" Content="истекли" Margin="-1,0,0,0" Command="{Binding SetStatusCommand}" CommandParameter="expired"
                        Classes.on="{Binding Status, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=expired}" />
                <Button Classes="chip" Content="сняты" Margin="-1,0,0,0" Command="{Binding SetStatusCommand}" CommandParameter="lifted"
                        Classes.on="{Binding Status, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=lifted}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Classes="chip" Content="любые" Command="{Binding SetTypeCommand}" CommandParameter="all"
                        Classes.on="{Binding Type, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=all}" />
                <Button Classes="chip" Content="сервер" Margin="-1,0,0,0" Command="{Binding SetTypeCommand}" CommandParameter="server"
                        Classes.on="{Binding Type, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=server}" />
                <Button Classes="chip" Content="роль" Margin="-1,0,0,0" Command="{Binding SetTypeCommand}" CommandParameter="role"
                        Classes.on="{Binding Type, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter=role}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="lbl" Text="С" VerticalAlignment="Center" />
                <CalendarDatePicker SelectedDate="{Binding From}" Watermark="—" />
                <TextBlock Classes="lbl" Text="ПО" VerticalAlignment="Center" />
                <CalendarDatePicker SelectedDate="{Binding To}" Watermark="—" />
                <Button Classes="icon" Content="&#xEAE2;" ToolTip.Tip="Сбросить фильтры" Command="{Binding ResetFiltersCommand}" />
            </StackPanel>
        </WrapPanel>

        <Panel DockPanel.Dock="Top" Margin="0,16,0,0" Height="1">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        </Panel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Classes="dim" Margin="0,8,0,0" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- The list -->
        <ScrollViewer Margin="0,4,0,0">
            <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BanRowViewModel">
                            <Border Classes="hair" Padding="0,8">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <c:StatusGlyph IsOnline="{Binding IsActive}"
                                                       Foreground="{Binding IsActive, Converter={x:Static vm:BoolBrush.TextOrDim}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Player}" FontWeight="Medium" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" Classes="mono dim" FontSize="10.5" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="{StaticResource DhBodyBrush}" Margin="14,0,0,0" />
                                    <TextBlock Classes="mono dim" FontSize="10.5" TextWrapping="Wrap" Margin="14,0,0,0">
                                        <Run Text="{Binding WhenText}" /><Run Text="  ·  " /><Run Text="{Binding DurationText}" /><Run Text="  ·  " /><Run Text="{Binding KindText}" /><Run Text="{Binding AdminText, StringFormat='  ·  {0}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button HorizontalAlignment="Center" Content="Показать ещё"
                        Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}" IsEnabled="{Binding !IsLoading}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
