<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:Class="DarkHaven.App.Views.NewsView"
             x:DataType="vm:NewsViewModel">
    <Grid ColumnDefinitions="280,*">
        <!-- The list -->
        <Border BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,0,1,0">
            <Panel>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" IsVisible="{Binding IsLoading}" />
                <TextBlock Classes="dim" Margin="16" Text="новостей нет" IsVisible="{Binding IsEmpty}" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NewsItemViewModel">
                                <Button Classes="row" Classes.selected="{Binding IsSelected}" Padding="16,8"
                                        Command="{Binding $parent[ItemsControl].((vm:NewsViewModel)DataContext).SelectCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="mono dim" FontSize="10" Text="{Binding DateText}" />
                                            <TextBlock Classes="mono dim" FontSize="10" Text="{Binding TagCaps}" IsVisible="{Binding HasTag}" />
                                            <TextBlock Classes="icon dim" FontSize="10" Text="&#xEBA0;" IsVisible="{Binding Pinned}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>

        <!-- The selected one -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="24,16" Spacing="12" MaxWidth="600" HorizontalAlignment="Left"
                        IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="mono dim" FontSize="10.5" Text="{Binding Selected.DateText}" />
                    <TextBlock Classes="mono dim" FontSize="10.5" Text="{Binding Selected.TagCaps}" />
                    <TextBlock Classes="icon dim" FontSize="10.5" Text="&#xEBA0;" IsVisible="{Binding Selected.Pinned}" />
                </StackPanel>
                <TextBlock Text="{Binding Selected.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="22" />
                <ItemsControl ItemsSource="{Binding Selected.Paragraphs}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                                 Foreground="{StaticResource DhBodyBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button HorizontalAlignment="Left" Command="{Binding Selected.OpenCommand}" IsVisible="{Binding Selected.HasLink}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="подробнее" VerticalAlignment="Center" />
                        <TextBlock Classes="icon" Text="&#xEB14;" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
