<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:views="using:DarkHaven.App.Views"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Styles>
        <Style Selector="Border.stat">
            <Setter Property="Width" Value="88" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <Style Selector="Border.stat TextBlock.v">
            <Setter Property="FontFamily" Value="{StaticResource DhMono}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.stat TextBlock.k">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        </Style>
        <Style Selector="Button.reg">
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        </Style>
        <Style Selector="Button.reg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DhBgHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource DhTextBrush}" />
        </Style>
        <Style Selector="Button.reg.hero">
            <Setter Property="Foreground" Value="{StaticResource DhTextBrush}" />
            <Setter Property="Background" Value="{StaticResource DhBgPanelBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource DhTextBrush}" />
        </Style>
        <Style Selector="Button.reg.hero:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource DhTextBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="HomeRow" x:DataType="vm:HomeServerRow">
            <Button Classes="row" Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ConnectRowCommand}"
                    CommandParameter="{Binding}"
                    Foreground="{Binding IsOffline, Converter={x:Static vm:BoolBrush.DimText}}">
                <Grid ColumnDefinitions="8,*,Auto,12" ColumnSpacing="8">
                    <c:StatusGlyph IsOnline="{Binding IsOnline}" IsOffline="{Binding IsOffline}" IsFull="{Binding IsFull}"
                                   IsQuarantine="{Binding IsQuarantine}" IsVisible="{Binding HasStatus}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding $parent[Button].Foreground}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Classes="mono dim" FontSize="10.5" Text="{Binding Population}"
                               IsVisible="{Binding HasPopulation}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="icon dim" FontSize="10" Text="&#xEAB6;" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer>
            <StackPanel Margin="20,16" Spacing="16">
                <!-- The server to continue on -->
                <StackPanel IsVisible="{Binding HasHero}">
                    <Border Height="52" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,128">
                            <StackPanel Margin="16,0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Classes="name" Text="{Binding Hero.Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="mono dim" FontSize="10.5" Text="{Binding Hero.Address}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="stat" IsVisible="{Binding Hero.HasPopulation}">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Classes="v" Text="{Binding Hero.Population}" />
                                    <TextBlock Classes="k" Text="игроков" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="stat" IsVisible="{Binding Hero.HasRound}">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Classes="v" Text="{Binding Hero.Round}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="k" Text="раунд" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Classes="stat" IsVisible="{Binding Hero.HasPing}">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Classes="v" Text="{Binding Hero.Ping}" />
                                    <TextBlock Classes="k" Text="отклик" />
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="4" Classes="primary" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                    Command="{Binding ConnectHeroCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="&#xEB2C;" FontSize="11" />
                                    <TextBlock Text="ИГРАТЬ" LetterSpacing="1.8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- The sector's regions, right under it -->
                    <Border Margin="0,8,0,0" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1,1,0,1" IsVisible="{Binding HasRegions}">
                        <ItemsControl ItemsSource="{Binding RegionStrip}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeRegionItem">
                                    <Button Classes="reg" Classes.hero="{Binding IsHero}"
                                            Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenRegionCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <c:StatusGlyph IsOnline="{Binding Node.IsOnline}" IsOffline="{Binding Node.IsOffline}"
                                                           IsQuarantine="{Binding Node.IsQuarantine}" IsFull="{Binding Node.IsFull}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Node.Name}" FontSize="11.5" FontWeight="Medium"
                                                       Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Classes="mono" FontSize="10" Text="{Binding Node.Entry.Players}"
                                                       Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"
                                                       IsVisible="{Binding Node.IsOnline}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Favourites and recent, side by side -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                    <StackPanel IsVisible="{Binding HasFavorites}">
                        <Border Classes="cap">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caps" Text="ИЗБРАННОЕ" />
                                <TextBlock Grid.Column="1" Classes="caps" Text="{Binding Favorites.Count}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource HomeRow}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" IsVisible="{Binding HasRecent}">
                        <Border Classes="cap">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caps" Text="НЕДАВНИЕ" />
                                <TextBlock Grid.Column="1" Classes="caps" Text="{Binding Recent.Count}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource HomeRow}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Width="200" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1,0,0,0"
                IsVisible="{Binding Friends.IsAvailable}">
            <views:FriendsPanel DataContext="{Binding Friends}" />
        </Border>
    </Grid>

</UserControl>
