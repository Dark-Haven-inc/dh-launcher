<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.ServerListView"
             x:DataType="vm:ServerListViewModel">

    <DockPanel Margin="28,24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Classes="h1" Text="РУхаб" />
                <TextBlock Classes="dim">
                    <Run Text="{Binding Servers.Count}" /><Run Text=" из " /><Run Text="{Binding TotalCount}" /><Run Text=" — русскоязычные и украинские сервера SS14" />
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="nav" Command="{Binding RefreshCommand}" Content="↻ Обновить" />
                <ToggleButton Classes="nav" IsChecked="{Binding MapView}" Content="Карта" />
            </StackPanel>
        </Grid>

        <TextBox DockPanel.Dock="Top" Margin="0,14,0,0" Watermark="Поиск серверов…" Text="{Binding Search}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
            <CheckBox Content="Скрыть пустые" IsChecked="{Binding HideEmpty}" />
            <CheckBox Content="Скрыть полные" IsChecked="{Binding HideFull}" />
            <CheckBox Content="Скрыть 18+" IsChecked="{Binding Hide18Plus}" />
            <CheckBox Content="★ только избранное" IsChecked="{Binding FavoritesOnly}" />
            <CheckBox Content="Сортировать по имени" IsChecked="{Binding SortByName}" />
        </StackPanel>

        <Grid DockPanel.Dock="Top" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Watermark="ss14://адрес — прямое подключение" Text="{Binding DirectAddress}" />
            <Button Grid.Column="1" Classes="nav" Margin="8,0,0,0" Content="Подключиться" Command="{Binding ConnectDirectCommand}" />
        </Grid>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" Margin="0,10"
                     IsVisible="{Binding IsLoading}" Foreground="{StaticResource DhAccentBrush}" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{StaticResource DhOfflineBrush}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,6" />

        <Grid Margin="0,12,0,0">
        <Border Classes="panel" CornerRadius="8" ClipToBounds="True" IsVisible="{Binding MapView}">
            <c:GalaxyMap x:Name="Galaxy" ItemsSource="{Binding Servers}" />
        </Border>

        <ScrollViewer IsVisible="{Binding !MapView}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ServerGroupViewModel">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Bold" FontSize="14"
                                           Foreground="{Binding IsMisc, Converter={x:Static vm:BoolBrush.DimText}}" />
                                <TextBlock Grid.Column="1" Text="{Binding SummaryLine}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ServerRowViewModel">
                                        <Border Classes="card" Padding="14,10">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                <Button Grid.Column="0" Classes="ghost" BorderThickness="0" Padding="6,2" Margin="0,0,8,0"
                                                        VerticalAlignment="Center" Command="{Binding ToggleFavoriteCommand}"
                                                        Content="{Binding IsFavorite, Converter={x:Static vm:FavGlyph.Instance}}"
                                                        Foreground="{Binding IsFavorite, Converter={x:Static vm:BoolBrush.AccentText}}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <ItemsControl ItemsSource="{Binding VisibleTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource DhBgHoverBrush}" CornerRadius="4" Padding="6,1">
                                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource DhTextDimBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding PingText}" VerticalAlignment="Center"
                                                           Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource DhTextDimBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Population}" VerticalAlignment="Center"
                                                           Margin="12,0" Foreground="{StaticResource DhAccentBrush}" />
                                                <Button Grid.Column="4" Classes="nav" Content="Играть" Command="{Binding ConnectCommand}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
