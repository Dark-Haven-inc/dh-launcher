<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cyberpunk palette: a night city in neon. Hot pink is the action (the primary button, what is
         chosen), cyan the lines and links, yellow the warnings, all on a blue-black. Contrast on DhBg: text
         about 18:1, dim 7.6:1, faint 5.5:1. Hover and press are see-through washes of cyan, so the grid
         shows through. Every palette defines the same keys (see Themes/Theme.cs). -->
    <Color x:Key="DhBg">#0A0A12</Color>
    <Color x:Key="DhBgPanel">#0F0F1B</Color>
    <Color x:Key="DhBgHover">#1405D9E8</Color>
    <Color x:Key="DhBgPress">#2605D9E8</Color>
    <Color x:Key="DhBorder">#23233C</Color>
    <Color x:Key="DhBorderStrong">#3B3B66</Color>
    <Color x:Key="DhText">#EAF6FF</Color>
    <Color x:Key="DhBody">#C7D3E6</Color>
    <Color x:Key="DhTextDim">#93A1BD</Color>
    <Color x:Key="DhTextFaint">#7A87A6</Color>

    <!-- The legacy design's names: the neons. -->
    <Color x:Key="DhBgElevated">#0F0F1B</Color>
    <Color x:Key="DhBorderBright">#3B3B66</Color>
    <Color x:Key="DhAccent">#05D9E8</Color>
    <Color x:Key="DhAccentBright">#7FF4FF</Color>
    <Color x:Key="DhCyan">#05D9E8</Color>
    <Color x:Key="DhOnline">#2BF5A0</Color>
    <Color x:Key="DhWarn">#FCEE0A</Color>
    <Color x:Key="DhDanger">#FF4545</Color>
    <Color x:Key="DhOffline">#5D6683</Color>
    <Color x:Key="DhFrontierSilver">#C7D3E6</Color>
    <Color x:Key="DhFrontierRed">#FF2A6D</Color>

    <!-- Active: neon pink with the night on it; the same pink as a line or text. -->
    <Color x:Key="DhActive">#FF2A6D</Color>
    <Color x:Key="DhActiveHover">#FF4D86</Color>
    <Color x:Key="DhActivePress">#D91E59</Color>
    <Color x:Key="DhOnActive">#0A0A12</Color>
    <Color x:Key="DhActiveLine">#FF2A6D</Color>

    <!-- Behind dialogs (connecting, Ctrl+K); the region map's grid and links. -->
    <Color x:Key="DhScrim">#CC05050A</Color>
    <Color x:Key="DhMapGrid">#14142A</Color>
    <Color x:Key="DhMapLink">#1F6E78</Color>

    <SolidColorBrush x:Key="DhBgBrush" Color="{StaticResource DhBg}" />
    <SolidColorBrush x:Key="DhBgPanelBrush" Color="{StaticResource DhBgPanel}" />
    <SolidColorBrush x:Key="DhBgHoverBrush" Color="{StaticResource DhBgHover}" />
    <SolidColorBrush x:Key="DhBgPressBrush" Color="{StaticResource DhBgPress}" />
    <SolidColorBrush x:Key="DhBorderBrush" Color="{StaticResource DhBorder}" />
    <SolidColorBrush x:Key="DhBorderStrongBrush" Color="{StaticResource DhBorderStrong}" />
    <SolidColorBrush x:Key="DhTextBrush" Color="{StaticResource DhText}" />
    <SolidColorBrush x:Key="DhBodyBrush" Color="{StaticResource DhBody}" />
    <SolidColorBrush x:Key="DhTextDimBrush" Color="{StaticResource DhTextDim}" />
    <SolidColorBrush x:Key="DhTextFaintBrush" Color="{StaticResource DhTextFaint}" />
    <SolidColorBrush x:Key="DhBgElevatedBrush" Color="{StaticResource DhBgElevated}" />
    <SolidColorBrush x:Key="DhBorderBrightBrush" Color="{StaticResource DhBorderBright}" />
    <SolidColorBrush x:Key="DhAccentBrush" Color="{StaticResource DhAccent}" />
    <SolidColorBrush x:Key="DhAccentBrightBrush" Color="{StaticResource DhAccentBright}" />
    <SolidColorBrush x:Key="DhCyanBrush" Color="{StaticResource DhCyan}" />
    <SolidColorBrush x:Key="DhOnlineBrush" Color="{StaticResource DhOnline}" />
    <SolidColorBrush x:Key="DhWarnBrush" Color="{StaticResource DhWarn}" />
    <SolidColorBrush x:Key="DhDangerBrush" Color="{StaticResource DhDanger}" />
    <SolidColorBrush x:Key="DhOfflineBrush" Color="{StaticResource DhOffline}" />
    <SolidColorBrush x:Key="DhFrontierSilverBrush" Color="{StaticResource DhFrontierSilver}" />
    <SolidColorBrush x:Key="DhFrontierRedBrush" Color="{StaticResource DhFrontierRed}" />
    <SolidColorBrush x:Key="DhActiveBrush" Color="{StaticResource DhActive}" />
    <SolidColorBrush x:Key="DhActiveHoverBrush" Color="{StaticResource DhActiveHover}" />
    <SolidColorBrush x:Key="DhActivePressBrush" Color="{StaticResource DhActivePress}" />
    <SolidColorBrush x:Key="DhOnActiveBrush" Color="{StaticResource DhOnActive}" />
    <SolidColorBrush x:Key="DhActiveLineBrush" Color="{StaticResource DhActiveLine}" />
    <SolidColorBrush x:Key="DhScrimBrush" Color="{StaticResource DhScrim}" />

    <!-- Fluent's own accent (focus rings, selection in lists), in the cyan. -->
    <Color x:Key="SystemAccentColor">#05D9E8</Color>
    <Color x:Key="SystemAccentColorDark1">#04AEBA</Color>
    <Color x:Key="SystemAccentColorDark2">#03828B</Color>
    <Color x:Key="SystemAccentColorDark3">#02575D</Color>
    <Color x:Key="SystemAccentColorLight1">#3FE5F0</Color>
    <Color x:Key="SystemAccentColorLight2">#7FF4FF</Color>
    <Color x:Key="SystemAccentColorLight3">#B5F9FF</Color>
</ResourceDictionary>
