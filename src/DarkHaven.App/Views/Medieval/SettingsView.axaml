<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:themes="using:DarkHaven.App.Themes"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.Medieval.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <!-- НАСТРОЙКИ as a charter: its articles in numbered chapters under red rubrics, each setting a line —
         what it is on the left in small caps, how it stands on the right. -->

    <UserControl.Styles>
        <Style Selector="Grid.srow">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Grid.srow > TextBlock:nth-child(1)">
            <Setter Property="FontFamily" Value="{StaticResource DhSerifCaps}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.chapter > Grid > TextBlock.num">
            <Setter Property="FontFamily" Value="{StaticResource DhSerifCaps}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource DhAccentBrush}" />
            <Setter Property="Width" Value="34" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:HsvSetting">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Classes="rubric" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="aside" Text="{Binding Hex}" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Width="14" Height="14" CornerRadius="7" Background="{Binding Swatch}"
                            BorderBrush="{StaticResource DhTextBrush}" BorderThickness="1" />
                </Grid>
                <Grid ColumnDefinitions="14,*,28" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Classes="key" Text="H" VerticalAlignment="Center" />
                    <c:GradientSlider Grid.Column="1" Maximum="360" Value="{Binding Hue}" Track="{Binding HueTrack}" />
                    <TextBlock Grid.Column="2" Classes="aside" Text="{Binding HueText}" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Classes="key" Text="S" VerticalAlignment="Center" />
                    <c:GradientSlider Grid.Row="1" Grid.Column="1" Value="{Binding Saturation}" Track="{Binding SaturationTrack}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="aside" Text="{Binding SaturationText}" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Classes="key" Text="V" VerticalAlignment="Center" />
                    <c:GradientSlider Grid.Row="2" Grid.Column="1" Value="{Binding Value}" Track="{Binding ValueTrack}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="aside" Text="{Binding ValueText}" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Margin="30,20,24,24" Spacing="22" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Classes="title" Text="Устав лаунчера" />
                <TextBlock Classes="aside" Text="Как вести себя лаунчеру и каким ему быть." />
            </StackPanel>
            <TextBlock Classes="aside" Foreground="{StaticResource DhAccentBrush}" Text="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Classes="chapter">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="num" Text="I." />
                    <Border Grid.Column="1" Classes="cap"><TextBlock Classes="rubric big" Text="Облик" /></Border>
                </Grid>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*" ColumnSpacing="12">
                        <TextBlock Text="Тема" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ComboBox Width="170" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="themes:Theme"><TextBlock Text="{Binding Title}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Краски">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="dh">
                                        <StackPanel Width="270" Margin="14" Spacing="16">
                                            <ContentControl Content="{Binding BaseColor}" />
                                            <ContentControl Content="{Binding ActiveColor}" />
                                            <Button Classes="small" Content="Вернуть как было" HorizontalAlignment="Left"
                                                    Command="{Binding ResetColorsCommand}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Classes="chapter">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="num" Text="II." />
                    <Border Grid.Column="1" Classes="cap"><TextBlock Classes="rubric big" Text="Хранилище" /></Border>
                </Grid>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Папка" />
                        <TextBlock Grid.Column="1" Text="{Binding DataDir}" FontSize="12.5" Foreground="{StaticResource DhTextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="Открыть" Command="{Binding OpenDataDirCommand}" />
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Кэш контента" />
                        <TextBlock Grid.Column="1" Classes="aside" Text="{Binding CacheSummary}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Очистить" Command="{Binding ClearContentCacheCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="hair" Padding="0,8">
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <Button Content="Проверить кэш" Command="{Binding VerifyContentCommand}" />
                        <Button Content="Убрать старые движки" Command="{Binding CullEnginesCommand}" />
                        <Button Content="Собрать журналы" Command="{Binding CollectLogsCommand}" />
                    </WrapPanel>
                </Border>
            </StackPanel>

            <StackPanel Classes="chapter">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="num" Text="III." />
                    <Border Grid.Column="1" Classes="cap"><TextBlock Classes="rubric big" Text="Обычаи" /></Border>
                </Grid>
                <Border Classes="hair" Padding="0,10">
                    <StackPanel Spacing="10">
                        <CheckBox Content="Обновлять контент самому" IsChecked="{Binding AutoUpdate}" />
                        <CheckBox Content="Сворачиваться, когда игра запущена" IsChecked="{Binding MinimizeOnLaunch}" />
                        <CheckBox Content="Совместимый рендер (GLES2)" IsChecked="{Binding CompatMode}" />
                        <CheckBox Content="Подробный журнал" IsChecked="{Binding VerboseLog}" />
                    </StackPanel>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*" ColumnSpacing="12">
                        <TextBlock Text="Предел загрузки" />
                        <Grid Grid.Column="1" Width="170" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBox Classes="mono" Text="{Binding DownloadLimit}" Watermark="без предела" Padding="8,4,44,4" />
                            <TextBlock Classes="aside" FontSize="11" Text="КБ/с" HorizontalAlignment="Right" Margin="0,0,8,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*" ColumnSpacing="12">
                        <TextBlock Text="Обновления" />
                        <Button Grid.Column="1" Content="Проверить" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Command="{Binding CheckForUpdatesCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Developers only (AppServices.DevOverrides). -->
            <StackPanel Classes="chapter" IsVisible="{Binding ShowConnection}">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="num" Text="IV." />
                    <Border Grid.Column="1" Classes="cap"><TextBlock Classes="rubric big" Text="Дороги" /></Border>
                </Grid>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*" ColumnSpacing="12">
                        <TextBlock Text="Авторизация" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                            <TextBox Classes="mono" Text="{Binding AuthUrl}" />
                            <Button Grid.Column="1" Classes="small" Content="как было" Command="{Binding ResetAuthUrlCommand}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*" ColumnSpacing="12">
                        <TextBlock Text="Сборки движка" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                            <TextBox Classes="mono" Text="{Binding BuildsUrl}" />
                            <Button Grid.Column="1" Classes="small" Content="как было" Command="{Binding ResetBuildsUrlCommand}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*" ColumnSpacing="12">
                        <TextBlock Text="Список регионов" />
                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding RegionsUrl}" Watermark="—" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*" ColumnSpacing="12">
                        <TextBlock Text="Платформа" />
                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding PlatformUrl}" Watermark="https://api.dark-haven.xyz" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Classes="chapter">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Classes="num" Text="V." />
                    <Border Grid.Column="1" Classes="cap"><TextBlock Classes="rubric big" Text="Discord" /></Border>
                </Grid>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="170,*" ColumnSpacing="12">
                        <TextBlock Text="ID приложения" />
                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding DiscordAppId}" Watermark="—" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
