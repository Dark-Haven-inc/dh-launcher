<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DarkHaven.App.ViewModels"
        xmlns:views="using:DarkHaven.App.Views"
        xmlns:c="using:DarkHaven.App.Controls"
        x:Class="DarkHaven.App.Views.Medieval.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Frontier 15 Launcher" Width="960" Height="600"
        MinWidth="880" MinHeight="560"
        Icon="/Assets/icon.ico"
        SystemDecorations="None"
        Background="{StaticResource DhBgBrush}">
    <!-- The medieval theme's window: the launcher drawn on an old sheet like a map. The aged parchment
         (Controls/Parchment.cs) with a map's neatline round it (Controls/MapFrame.cs), the title in a
         cartouche, the pages listed down the left as a book's contents, a compass rose under them. The
         pages are the monochrome ones, which Themes/Styles/Medieval.axaml redraws in ink. -->

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="vm:RegionsViewModel"><views:RegionsView /></DataTemplate>
        <DataTemplate DataType="vm:ServerListViewModel"><views:ServerListView /></DataTemplate>
        <DataTemplate DataType="vm:MonitoringViewModel"><views:MonitoringView /></DataTemplate>
        <DataTemplate DataType="vm:LocalViewModel"><views:LocalView /></DataTemplate>
        <DataTemplate DataType="vm:BanListViewModel"><views:BanListView /></DataTemplate>
        <DataTemplate DataType="vm:NewsViewModel"><views:NewsView /></DataTemplate>
        <DataTemplate DataType="vm:AdminViewModel"><views:AdminView /></DataTemplate>
        <DataTemplate DataType="vm:AccountViewModel"><views:AccountView /></DataTemplate>
        <DataTemplate DataType="vm:ProfileViewModel"><views:ProfileView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:ConnectingViewModel"><views:ConnectingView /></DataTemplate>
        <DataTemplate DataType="vm:PaletteViewModel"><views:PaletteView /></DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <c:Parchment Background="{StaticResource DhBgBrush}" />
        <c:MapFrame Stroke="{StaticResource DhTextBrush}" Opacity="0.8" />

        <DockPanel Margin="{x:Static c:MapFrame.Inside}">
            <!-- The title bar. With no OS frame it is what moves the window (double-click maximizes). -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="42" Background="Transparent">
                <Grid ColumnDefinitions="*,Auto,*">
                    <!-- The cartouche: the name between two flourishes. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Path Data="M2,5 H32 M32,5 L37,1.5 L42,5 L37,8.5 Z M0,5 A2,2 0 1 0 4,5 A2,2 0 1 0 0,5 Z" VerticalAlignment="Center"
                              Fill="{StaticResource DhTextDimBrush}" Stroke="{StaticResource DhTextDimBrush}" StrokeThickness="1" />
                        <TextBlock Classes="mtitle" Text="Frontier XV" VerticalAlignment="Center" />
                        <Path Data="M2,5 H32 M32,5 L37,1.5 L42,5 L37,8.5 Z M0,5 A2,2 0 1 0 4,5 A2,2 0 1 0 0,5 Z" VerticalAlignment="Center"
                              Fill="{StaticResource DhTextDimBrush}" Stroke="{StaticResource DhTextDimBrush}" StrokeThickness="1"
                              RenderTransform="scale(-1,1)" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <Button Classes="mtop" ToolTip.Tip="уведомления" IsVisible="{Binding Notifications.IsAvailable}">
                            <Panel>
                                <Path Data="{StaticResource DhBellGeometry}" Fill="{StaticResource DhTextBrush}" Stretch="Uniform" Width="14" Height="14" />
                                <Ellipse Width="6" Height="6" Fill="{StaticResource DhActiveBrush}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                                         IsVisible="{Binding Notifications.HasUnread}" />
                            </Panel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="dh">
                                    <views:NotificationsPanel DataContext="{Binding Notifications}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="mtop" Command="{Binding OpenAccountCommand}" Classes.active="{Binding IsAccountPage}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Classes="icon" Text="&#xEB99;" FontSize="13" />
                                <TextBlock Text="{Binding AccountName, TargetNullValue='гость', FallbackValue='гость'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="mtop" ToolTip.Tip="свернуть" Click="OnMinimize">
                            <Path Data="M0,0.5 H10" Width="10" Height="1" />
                        </Button>
                        <Button Classes="mtop close" ToolTip.Tip="закрыть" Click="OnClose">
                            <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Width="10" Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- A double rule under the title. -->
            <Border DockPanel.Dock="Top" Height="4" BorderBrush="{StaticResource DhTextDimBrush}" BorderThickness="0,1,0,1" Opacity="0.75" />

            <!-- The contents down the left, the compass rose and the versions under them. -->
            <Border DockPanel.Dock="Left" Width="172" BorderBrush="{StaticResource DhBorderStrongBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,10" Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="lbl" Text="лаунчер" />
                            <TextBlock Grid.Column="1" Classes="lbl" Text="{Binding LauncherVersion}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="lbl" Text="движок" />
                            <TextBlock Grid.Column="1" Classes="lbl" Text="{Binding EngineVersion}" />
                        </Grid>
                        <Button Classes="small primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                                Content="{Binding UpdateButtonText}" Command="{Binding UpdateActionCommand}"
                                IsVisible="{Binding ShowUpdateButton}" />
                        <TextBlock Classes="lbl" Margin="0,4,0,0" HorizontalAlignment="Center"
                                   Text="{Binding UpdateStatusText}" IsVisible="{Binding ShowUpdateStatus}" />
                    </StackPanel>

                    <!-- The compass rose, as on the corner of a chart: north in red. -->
                    <Viewbox DockPanel.Dock="Bottom" Width="88" Height="88" Margin="0,0,0,10" Opacity="0.7" IsHitTestVisible="False">
                        <Canvas Width="100" Height="100">
                            <Path StrokeThickness="0.8" Stroke="{StaticResource DhTextDimBrush}"
                                  Data="M16.0,50 A34,34 0 1 1 84.0,50 A34,34 0 1 1 16.0,50 Z M19.0,50 A31,31 0 1 1 81.0,50 A31,31 0 1 1 19.0,50 Z" />
                            <Path StrokeThickness="0.6" Stroke="{StaticResource DhTextDimBrush}"
                                  Data="M50.0,19.0 L50.0,16.0 M55.4,19.5 L55.9,16.5 M60.6,20.9 L61.6,18.1 M65.5,23.2 L67.0,20.6 M69.9,26.3 L71.9,24.0 M73.7,30.1 L76.0,28.1 M76.8,34.5 L79.4,33.0 M79.1,39.4 L81.9,38.4 M80.5,44.6 L83.5,44.1 M81.0,50.0 L84.0,50.0 M80.5,55.4 L83.5,55.9 M79.1,60.6 L81.9,61.6 M76.8,65.5 L79.4,67.0 M73.7,69.9 L76.0,71.9 M69.9,73.7 L71.9,76.0 M65.5,76.8 L67.0,79.4 M60.6,79.1 L61.6,81.9 M55.4,80.5 L55.9,83.5 M50.0,81.0 L50.0,84.0 M44.6,80.5 L44.1,83.5 M39.4,79.1 L38.4,81.9 M34.5,76.8 L33.0,79.4 M30.1,73.7 L28.1,76.0 M26.3,69.9 L24.0,71.9 M23.2,65.5 L20.6,67.0 M20.9,60.6 L18.1,61.6 M19.5,55.4 L16.5,55.9 M19.0,50.0 L16.0,50.0 M19.5,44.6 L16.5,44.1 M20.9,39.4 L18.1,38.4 M23.2,34.5 L20.6,33.0 M26.3,30.1 L24.0,28.1 M30.1,26.3 L28.1,24.0 M34.5,23.2 L33.0,20.6 M39.4,20.9 L38.4,18.1 M44.6,19.5 L44.1,16.5" />
                            <Path Fill="{StaticResource DhTextDimBrush}"
                                  Data="M50.0,50.0 L98.0,50.0 L57.0,43.0 Z M50.0,50.0 L50.0,98.0 L57.0,57.0 Z M50.0,50.0 L2.0,50.0 L43.0,57.0 Z M50.0,50.0 L71.2,28.8 L56.4,50.0 Z M50.0,50.0 L71.2,71.2 L50.0,56.4 Z M50.0,50.0 L28.8,71.2 L43.6,50.0 Z M50.0,50.0 L28.8,28.8 L50.0,43.6 Z" />
                            <Path Fill="{StaticResource DhAccentBrush}" Data="M50.0,50.0 L50.0,2.0 L43.0,43.0 Z" />
                            <Path StrokeThickness="0.8" Stroke="{StaticResource DhTextBrush}" StrokeJoin="Round"
                                  Data="M50.0,50.0 L50.0,2.0 L57.0,43.0 Z M50.0,2.0 L43.0,43.0 L50.0,50.0 M50.0,50.0 L98.0,50.0 L57.0,57.0 Z M98.0,50.0 L57.0,43.0 L50.0,50.0 M50.0,50.0 L50.0,98.0 L43.0,57.0 Z M50.0,98.0 L57.0,57.0 L50.0,50.0 M50.0,50.0 L2.0,50.0 L43.0,43.0 Z M2.0,50.0 L43.0,57.0 L50.0,50.0 M50.0,50.0 L71.2,28.8 L50.0,43.6 Z M71.2,28.8 L56.4,50.0 M50.0,50.0 L71.2,71.2 L56.4,50.0 Z M71.2,71.2 L50.0,56.4 M50.0,50.0 L28.8,71.2 L50.0,56.4 Z M28.8,71.2 L43.6,50.0 M50.0,50.0 L28.8,28.8 L43.6,50.0 Z M28.8,28.8 L50.0,43.6" />
                            <Path Fill="{StaticResource DhBgBrush}" Stroke="{StaticResource DhTextBrush}" StrokeThickness="0.8"
                                  Data="M47.5,50 A2.5,2.5 0 1 1 52.5,50 A2.5,2.5 0 1 1 47.5,50 Z" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Classes="caps" Text="оглавление" Margin="16,0,0,6" />
                        <Button Classes="mnav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Home}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Home}}">
                            <StackPanel Orientation="Horizontal"><Path Classes="mark" Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource DhActiveLineBrush}" Margin="-8,0,2,0" VerticalAlignment="Center" /><TextBlock Classes="num" Text="I" /><TextBlock Classes="label" Text="главная" /></StackPanel>
                        </Button>
                        <Button Classes="mnav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Regions}"
                                Classes.active="{Binding IsRegionsPage}">
                            <StackPanel Orientation="Horizontal"><Path Classes="mark" Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource DhActiveLineBrush}" Margin="-8,0,2,0" VerticalAlignment="Center" /><TextBlock Classes="num" Text="II" /><TextBlock Classes="label" Text="регионы" /></StackPanel>
                        </Button>
                        <Button Classes="mnav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Servers}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Servers}}">
                            <StackPanel Orientation="Horizontal"><Path Classes="mark" Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource DhActiveLineBrush}" Margin="-8,0,2,0" VerticalAlignment="Center" /><TextBlock Classes="num" Text="III" /><TextBlock Classes="label" Text="серверы" /></StackPanel>
                        </Button>
                        <Button Classes="mnav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Monitoring}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Monitoring}}">
                            <StackPanel Orientation="Horizontal"><Path Classes="mark" Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource DhActiveLineBrush}" Margin="-8,0,2,0" VerticalAlignment="Center" /><TextBlock Classes="num" Text="IV" /><TextBlock Classes="label" Text="мониторинг" /></StackPanel>
                        </Button>
                        <Button Classes="mnav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Local}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Local}}">
                            <StackPanel Orientation="Horizontal"><Path Classes="mark" Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource DhActiveLineBrush}" Margin="-8,0,2,0" VerticalAlignment="Center" /><TextBlock Classes="num" Text="V" /><TextBlock Classes="label" Text="локалка" /></StackPanel>
                        </Button>
                        <Button Classes="mnav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.News}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.News}}">
                            <StackPanel Orientation="Horizontal"><Path Classes="mark" Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource DhActiveLineBrush}" Margin="-8,0,2,0" VerticalAlignment="Center" /><TextBlock Classes="num" Text="VI" /><TextBlock Classes="label" Text="новости" /></StackPanel>
                        </Button>
                        <Button Classes="mnav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Settings}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Settings}}">
                            <StackPanel Orientation="Horizontal"><Path Classes="mark" Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource DhActiveLineBrush}" Margin="-8,0,2,0" VerticalAlignment="Center" /><TextBlock Classes="num" Text="VII" /><TextBlock Classes="label" Text="настройки" /></StackPanel>
                        </Button>
                        <Button Classes="mnav" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Admin}" IsVisible="{Binding Admin.CanSeeAdmin}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Admin}}">
                            <StackPanel Orientation="Horizontal"><Path Classes="mark" Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource DhActiveLineBrush}" Margin="-8,0,2,0" VerticalAlignment="Center" /><TextBlock Classes="num" Text="VIII" /><TextBlock Classes="label" Text="админ" /></StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- A watched region came back, or a slot opened: one line on top of the page. -->
            <Border DockPanel.Dock="Top" MinHeight="34" Padding="18,4" BorderBrush="{StaticResource DhBorderStrongBrush}" BorderThickness="0,0,0,1"
                    Background="{StaticResource DhBgHoverBrush}" IsVisible="{Binding ShowRegionBanner}">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <c:StatusGlyph Kind="on" Margin="0,0,8,0" Foreground="{StaticResource DhOnlineBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding RegionBannerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary small" Content="играть" Command="{Binding ConnectOnlineRegionCommand}" />
                        <Button Classes="small" Content="позже" Command="{Binding DismissRegionBannerCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Top" MinHeight="34" Padding="18,4" BorderBrush="{StaticResource DhBorderStrongBrush}" BorderThickness="0,0,0,1"
                    Background="{StaticResource DhBgHoverBrush}" IsVisible="{Binding ShowSlotWaitBanner}">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <c:StatusGlyph Kind="full" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding SlotWaitBannerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="small" Content="не ждать" Command="{Binding CancelSlotWaitCommand}" />
                </Grid>
            </Border>

            <ContentControl Content="{Binding Current}" />
        </DockPanel>

        <!-- Connecting: a dialog over the dimmed sheet, under the title bar (inside the frame, 14 + 42 + 4). -->
        <Border Margin="14,60,14,14" Background="{StaticResource DhScrimBrush}"
                IsVisible="{Binding Connecting, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding Connecting}" />
        </Border>

        <!-- Quick switcher (Ctrl+K). -->
        <Border Margin="14,60,14,14" Background="{StaticResource DhScrimBrush}" PointerPressed="OnPaletteBackdropPressed"
                IsVisible="{Binding Palette, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding Palette}" />
        </Border>

        <!-- Resize grips along the edges (there is no OS frame to grab). -->
        <Border Classes="grip" Tag="N" Height="4" VerticalAlignment="Top" Cursor="TopSide" />
        <Border Classes="grip" Tag="S" Height="4" VerticalAlignment="Bottom" Cursor="BottomSide" />
        <Border Classes="grip" Tag="W" Width="4" HorizontalAlignment="Left" Cursor="LeftSide" />
        <Border Classes="grip" Tag="E" Width="4" HorizontalAlignment="Right" Cursor="RightSide" />
        <Border Classes="grip" Tag="NW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="TopLeftCorner" />
        <Border Classes="grip" Tag="NE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="TopRightCorner" />
        <Border Classes="grip" Tag="SW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="BottomLeftCorner" />
        <Border Classes="grip" Tag="SE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner" />
    </Panel>
</Window>
