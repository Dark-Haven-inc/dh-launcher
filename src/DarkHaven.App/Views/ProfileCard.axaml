<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:Class="DarkHaven.App.Views.ProfileCard"
             x:DataType="vm:IProfileCard">
    <!-- A player's card: their banner and avatar (their own colours), then plain facts. -->
    <Border Background="{StaticResource DhBgBrush}" ClipToBounds="True">
        <StackPanel>
            <Panel Height="72">
                <Border Background="{Binding CardBannerBrush}" />
                <Image Source="{Binding CardBanner}" Stretch="UniformToFill" IsVisible="{Binding CardHasBanner}" />
            </Panel>
            <Border Width="56" Height="56" Margin="16,-28,0,0" HorizontalAlignment="Left"
                    Background="{StaticResource DhBgPanelBrush}" BorderBrush="{Binding CardRingBrush}" BorderThickness="1">
                <Panel>
                    <Image Source="{Binding CardAvatar}" Stretch="UniformToFill" IsVisible="{Binding CardHasAvatar}" />
                    <TextBlock Text="15" FontFamily="{StaticResource DhMono}" FontWeight="Medium" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !CardHasAvatar}" />
                </Panel>
            </Border>
            <StackPanel Margin="16,8,16,16" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding CardName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CardSubtitle}" Classes="dim" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel IsVisible="{Binding CardHasAbout}">
                    <Border Classes="cap"><TextBlock Text="О СЕБЕ" Classes="caps" /></Border>
                    <TextBlock Text="{Binding CardAbout}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource DhBodyBrush}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="в сети с" Classes="dim" />
                    <TextBlock Grid.Column="1" Text="{Binding CardMemberSince}" Classes="mono" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
