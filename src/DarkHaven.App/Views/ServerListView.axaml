<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.ServerListView"
             x:DataType="vm:ServerListViewModel">

    <UserControl.Styles>
        <Style Selector="Border.tag">
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.tag TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DhMono}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="{StaticResource DhBorderStrongBrush}" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style Selector="Button.fav">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="16" />
            <Setter Property="FontFamily" Value="{StaticResource DhMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="20,16">
        <!-- Search, direct connect, tools -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,200,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4">
            <Grid>
                <TextBox Watermark="поиск" Text="{Binding Search}" Padding="28,4,8,4" />
                <TextBlock Classes="icon dim" Text="&#xEA6D;" FontSize="11" Margin="10,0,0,0" IsHitTestVisible="False" />
            </Grid>
            <TextBox Grid.Column="1" Classes="mono" Watermark="ss14://" Text="{Binding DirectAddress}" />
            <Button Grid.Column="2" Classes="icon" Content="&#xEA9C;" ToolTip.Tip="подключиться" Command="{Binding ConnectDirectCommand}" />
            <Border Grid.Column="3" Classes="sep" />
            <ToggleButton Grid.Column="4" Classes="chip glyph" Content="&#xEC05;" ToolTip.Tip="карта"
                          IsChecked="{Binding MapView}" />
            <Button Grid.Column="5" Classes="icon" Content="&#xEB37;" ToolTip.Tip="обновить" Command="{Binding RefreshCommand}" />
            <Button Grid.Column="6" Command="{Binding ToggleApplyCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="icon" Text="&#xEA60;" FontSize="11" />
                    <TextBlock Text="разместить" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Classes="lbl" Text="СКРЫТЬ" VerticalAlignment="Center" />
            <ToggleButton Classes="chip" Content="пустые" IsChecked="{Binding HideEmpty}" />
            <ToggleButton Classes="chip" Content="полные" IsChecked="{Binding HideFull}" />
            <ToggleButton Classes="chip" Content="18+" IsChecked="{Binding Hide18Plus}" />
            <Border Classes="sep" />
            <ToggleButton Classes="chip" IsChecked="{Binding FavoritesOnly}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Classes="icon" Text="&#xEB59;" FontSize="10" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                    <TextBlock Text="избранное" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="chip" Content="А–Я" IsChecked="{Binding SortByName}" />
            <Border Classes="sep" />
            <TextBlock Classes="lbl" Text="RP" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <ToggleButton Classes="chip" Content="нет" IsChecked="{Binding RpNone}" />
                <ToggleButton Classes="chip" Content="лёгкий" IsChecked="{Binding RpLow}" Margin="-1,0,0,0" />
                <ToggleButton Classes="chip" Content="средний" IsChecked="{Binding RpMed}" Margin="-1,0,0,0" />
                <ToggleButton Classes="chip" Content="высокий" IsChecked="{Binding RpHigh}" Margin="-1,0,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Asking for a server to be listed -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="16" Margin="0,16,0,0" IsVisible="{Binding ShowApply}">
            <StackPanel Spacing="8">
                <TextBlock Text="ЗАЯВКА" Classes="caps" />
                <TextBlock Classes="dim" IsVisible="{Binding !CanApply}" Text="войдите в аккаунт" />
                <StackPanel Spacing="8" IsVisible="{Binding CanApply}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <TextBox Watermark="название" Text="{Binding ApplyName}" MaxLength="60" />
                        <TextBox Grid.Column="1" Classes="mono" Watermark="ss14://адрес:порт" Text="{Binding ApplyAddress}" MaxLength="200" />
                    </Grid>
                    <TextBox Watermark="о сервере" Text="{Binding ApplyDescription}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxLength="500" VerticalContentAlignment="Top" />
                    <TextBox Watermark="контакт" Text="{Binding ApplyContact}" MaxLength="100" />
                    <Button Classes="primary" HorizontalAlignment="Left" Content="ОТПРАВИТЬ"
                            Command="{Binding SubmitApplicationCommand}" IsEnabled="{Binding !ApplyBusy}" />
                </StackPanel>
                <TextBlock Text="{Binding ApplyStatus, Converter={x:Static vm:Lowercase.Instance}}" TextWrapping="Wrap"
                           IsVisible="{Binding ApplyStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <StackPanel IsVisible="{Binding HasMyApplications}" Margin="0,8,0,0">
                    <Border Classes="cap"><TextBlock Classes="caps" Text="МОИ ЗАЯВКИ" /></Border>
                    <ItemsControl ItemsSource="{Binding MyApplications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MyApplicationRow">
                                <Border Classes="hair" MinHeight="24" Padding="0,4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock>
                                                <Run Text="{Binding Name}" /><Run Text="  " /><Run Text="{Binding StatusText, Converter={x:Static vm:Lowercase.Instance}}" Foreground="{StaticResource DhTextDimBrush}" /><Run Text="  " /><Run Text="{Binding WhenText}" Foreground="{StaticResource DhTextFaintBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Note}" Classes="dim" FontSize="11" TextWrapping="Wrap"
                                                       IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <!-- A listed server that runs at set times: its next launch (the countdown, favourites' alerts). -->
                                            <StackPanel Spacing="4" Margin="0,2,0,0" IsVisible="{Binding CanSchedule}">
                                                <TextBlock Text="{Binding LaunchNow, Converter={x:Static vm:Lowercase.Instance}}" Classes="dim" FontSize="11" TextWrapping="Wrap" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <CalendarDatePicker SelectedDate="{Binding LaunchDate}" Watermark="дата" Width="130" Margin="0,0,6,4" />
                                                    <TimePicker SelectedTime="{Binding LaunchTime}" ClockIdentifier="24HourClock" MinuteIncrement="5" Margin="0,0,6,4" />
                                                    <TextBox Text="{Binding LaunchNote}" Watermark="подпись: ивент, карта" MaxLength="100" Width="190" Margin="0,0,6,4" />
                                                    <Button Classes="small" Content="поставить таймер" Margin="0,0,6,4"
                                                            Command="{Binding $parent[ItemsControl].((vm:ServerListViewModel)DataContext).SaveLaunchCommand}" CommandParameter="{Binding}" />
                                                    <Button Classes="link" Content="убрать" Margin="0,0,0,4" VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((vm:ServerListViewModel)DataContext).ClearLaunchCommand}" CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="link" Content="отозвать" VerticalAlignment="Center"
                                                IsVisible="{Binding CanWithdraw}"
                                                Command="{Binding $parent[ItemsControl].((vm:ServerListViewModel)DataContext).WithdrawApplicationCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <Panel DockPanel.Dock="Top" Margin="0,16,0,0" Height="1">
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        </Panel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error, Converter={x:Static vm:Lowercase.Instance}}" Classes="dim" Margin="0,8,0,0"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Top" Classes="dim" Margin="0,8,0,0" IsVisible="{Binding IsEmpty}" Text="серверов нет" />

        <Panel Margin="0,4,0,0">
            <!-- Map -->
            <Grid ColumnDefinitions="*,272" IsVisible="{Binding MapView}" Margin="-20,0,-20,-16">
                <c:FlatMap x:Name="Map" ItemsSource="{Binding MapNodes}" SelectedItem="{Binding SelectedServer}" />
                <Border Grid.Column="1" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1,0,0,0" Padding="16">
                    <ScrollViewer IsVisible="{Binding SelectedServer, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="caps" Text="{Binding SelectedServer.RegionLabel}"
                                           IsVisible="{Binding SelectedServer.RegionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Classes="name" Text="{Binding SelectedServer.Name}" TextWrapping="Wrap" />
                                <TextBlock Classes="mono dim" FontSize="10.5" Text="{Binding SelectedServer.Address}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedServer.VisibleTags}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="tag"><TextBlock Text="{Binding}" /></Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <Border Classes="hair" Height="24">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Classes="dim" Text="состояние" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <c:StatusGlyph IsOnline="{Binding SelectedServer.IsOnline}" IsOffline="{Binding SelectedServer.IsOffline}"
                                                               IsFull="{Binding SelectedServer.IsFull}" />
                                                <TextBlock Text="{Binding SelectedServer.StateText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="hair" Height="24">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Classes="dim" Text="игроков" />
                                            <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Text="{Binding SelectedServer.Population}" />
                                        </Grid>
                                    </Border>
                                    <Border Classes="hair" Height="24"
                                            IsVisible="{Binding SelectedServer.RoundInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <TextBlock Classes="dim" Text="раунд" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedServer.RoundInfo, Converter={x:Static vm:Lowercase.Instance}}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="8">
                                <Button Classes="primary" Height="28" HorizontalAlignment="Stretch" Command="{Binding SelectedServer.ConnectCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="icon" Text="&#xEB2C;" FontSize="11" />
                                        <TextBlock Text="ИГРАТЬ" LetterSpacing="1.8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Content="{Binding SelectedServer.SlotLabel, Converter={x:Static vm:Lowercase.Instance}}" Command="{Binding SelectedServer.WaitForSlotCommand}"
                                        IsVisible="{Binding SelectedServer.CanWaitForSlot}" />
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding SelectedServer.ToggleFavoriteCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="icon" FontSize="11" Text="{Binding SelectedServer.IsFavorite, Converter={x:Static vm:FavGlyph.Instance}}" />
                                        <TextBlock Text="избранное" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- List, grouped by network -->
            <ScrollViewer IsVisible="{Binding !MapView}" Padding="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerGroupViewModel">
                            <StackPanel>
                                <Border Classes="cap">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="caps" Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1" Classes="caps" Text="{Binding SummaryLine}" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Servers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ServerRowViewModel">
                                            <Border Classes="hair" Height="24" Classes.off="{Binding IsOffline}">
                                                <Grid ColumnDefinitions="16,8,*,Auto,48,48,56" ColumnSpacing="12" VerticalAlignment="Center">
                                                    <Button Classes="fav" Command="{Binding ToggleFavoriteCommand}"
                                                            Content="{Binding IsFavorite, Converter={x:Static vm:FavGlyph.Instance}}"
                                                            Foreground="{Binding IsFavorite, Converter={x:Static vm:BoolBrush.TextOrDim}}" />
                                                    <c:StatusGlyph Grid.Column="1" IsOnline="{Binding IsOnline}" IsOffline="{Binding IsOffline}" IsFull="{Binding IsFull}"
                                                                   Foreground="{Binding IsOnline, Converter={x:Static vm:BoolBrush.OnlineOffline}}" />
                                                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                   Foreground="{Binding IsOnline, Converter={x:Static vm:BoolBrush.OnlineOffline}}" />
                                                        <TextBlock Grid.Column="1" Classes="mono" FontSize="10.5" VerticalAlignment="Center"
                                                                   Text="{Binding LaunchText, Converter={x:Static vm:Lowercase.Instance}}" IsVisible="{Binding HasLaunch}"
                                                                   Foreground="{StaticResource DhWarnBrush}" />
                                                    </Grid>
                                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding VisibleTags}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Classes="tag"><TextBlock Text="{Binding}" /></Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="4" Classes="mono dim" FontSize="10.5" Text="{Binding PingText}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Classes="mono" FontSize="10.5" Text="{Binding Population}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Foreground="{Binding IsFull, Converter={x:Static vm:BoolBrush.DimText}}" />
                                                    <Button Grid.Column="6" Classes="small" Content="играть" HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center" Command="{Binding ConnectCommand}" IsVisible="{Binding IsOnline}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
