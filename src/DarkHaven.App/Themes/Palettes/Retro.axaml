<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Retro palette: a green phosphor screen. One hue, told apart only by brightness — even danger
         and warnings; what stands out is inverted (Themes/Styles/Retro.axaml). Contrast on DhBg: text
         about 15.8:1, dim 8.6:1, faint 5.5:1. Every palette defines the same keys (see Themes/Theme.cs). -->
    <Color x:Key="DhBg">#050A06</Color>
    <Color x:Key="DhBgPanel">#07120A</Color>
    <Color x:Key="DhBgHover">#0A1A0E</Color>
    <Color x:Key="DhBgPress">#0E2413</Color>
    <Color x:Key="DhBorder">#0F2A16</Color>
    <Color x:Key="DhBorderStrong">#183F22</Color>
    <Color x:Key="DhText">#7CFF9E</Color>
    <Color x:Key="DhBody">#5EE68A</Color>
    <Color x:Key="DhTextDim">#3BC266</Color>
    <Color x:Key="DhTextFaint">#2A9A4C</Color>

    <!-- The legacy design's names; here they map onto the greens. -->
    <Color x:Key="DhBgElevated">#07120A</Color>
    <Color x:Key="DhBorderBright">#183F22</Color>
    <Color x:Key="DhAccent">#7CFF9E</Color>
    <Color x:Key="DhAccentBright">#B4FFC8</Color>
    <Color x:Key="DhCyan">#7CFF9E</Color>
    <Color x:Key="DhOnline">#7CFF9E</Color>
    <Color x:Key="DhWarn">#3BC266</Color>
    <Color x:Key="DhDanger">#7CFF9E</Color>
    <Color x:Key="DhOffline">#2A9A4C</Color>
    <Color x:Key="DhFrontierSilver">#7CFF9E</Color>
    <Color x:Key="DhFrontierRed">#7CFF9E</Color>

    <!-- Active: reverse video — the text color as the fill, the background's as the text on it. -->
    <Color x:Key="DhActive">#7CFF9E</Color>
    <Color x:Key="DhActiveHover">#A6FFBC</Color>
    <Color x:Key="DhActivePress">#5EE68A</Color>
    <Color x:Key="DhOnActive">#050A06</Color>
    <Color x:Key="DhActiveLine">#7CFF9E</Color>

    <!-- Behind dialogs (connecting, Ctrl+K); the region map's grid and links. -->
    <Color x:Key="DhScrim">#C7020502</Color>
    <Color x:Key="DhMapGrid">#0A160D</Color>
    <Color x:Key="DhMapLink">#1F5A30</Color>

    <SolidColorBrush x:Key="DhBgBrush" Color="{StaticResource DhBg}" />
    <SolidColorBrush x:Key="DhBgPanelBrush" Color="{StaticResource DhBgPanel}" />
    <SolidColorBrush x:Key="DhBgHoverBrush" Color="{StaticResource DhBgHover}" />
    <SolidColorBrush x:Key="DhBgPressBrush" Color="{StaticResource DhBgPress}" />
    <SolidColorBrush x:Key="DhBorderBrush" Color="{StaticResource DhBorder}" />
    <SolidColorBrush x:Key="DhBorderStrongBrush" Color="{StaticResource DhBorderStrong}" />
    <SolidColorBrush x:Key="DhTextBrush" Color="{StaticResource DhText}" />
    <SolidColorBrush x:Key="DhBodyBrush" Color="{StaticResource DhBody}" />
    <SolidColorBrush x:Key="DhTextDimBrush" Color="{StaticResource DhTextDim}" />
    <SolidColorBrush x:Key="DhTextFaintBrush" Color="{StaticResource DhTextFaint}" />
    <SolidColorBrush x:Key="DhBgElevatedBrush" Color="{StaticResource DhBgElevated}" />
    <SolidColorBrush x:Key="DhBorderBrightBrush" Color="{StaticResource DhBorderBright}" />
    <SolidColorBrush x:Key="DhAccentBrush" Color="{StaticResource DhAccent}" />
    <SolidColorBrush x:Key="DhAccentBrightBrush" Color="{StaticResource DhAccentBright}" />
    <SolidColorBrush x:Key="DhCyanBrush" Color="{StaticResource DhCyan}" />
    <SolidColorBrush x:Key="DhOnlineBrush" Color="{StaticResource DhOnline}" />
    <SolidColorBrush x:Key="DhWarnBrush" Color="{StaticResource DhWarn}" />
    <SolidColorBrush x:Key="DhDangerBrush" Color="{StaticResource DhDanger}" />
    <SolidColorBrush x:Key="DhOfflineBrush" Color="{StaticResource DhOffline}" />
    <SolidColorBrush x:Key="DhFrontierSilverBrush" Color="{StaticResource DhFrontierSilver}" />
    <SolidColorBrush x:Key="DhFrontierRedBrush" Color="{StaticResource DhFrontierRed}" />
    <SolidColorBrush x:Key="DhActiveBrush" Color="{StaticResource DhActive}" />
    <SolidColorBrush x:Key="DhActiveHoverBrush" Color="{StaticResource DhActiveHover}" />
    <SolidColorBrush x:Key="DhActivePressBrush" Color="{StaticResource DhActivePress}" />
    <SolidColorBrush x:Key="DhOnActiveBrush" Color="{StaticResource DhOnActive}" />
    <SolidColorBrush x:Key="DhActiveLineBrush" Color="{StaticResource DhActiveLine}" />
    <SolidColorBrush x:Key="DhScrimBrush" Color="{StaticResource DhScrim}" />

    <!-- Fluent's own accent (focus rings, selection in lists), in the phosphor's green. -->
    <Color x:Key="SystemAccentColor">#7CFF9E</Color>
    <Color x:Key="SystemAccentColorDark1">#5EE68A</Color>
    <Color x:Key="SystemAccentColorDark2">#3BC266</Color>
    <Color x:Key="SystemAccentColorDark3">#183F22</Color>
    <Color x:Key="SystemAccentColorLight1">#A6FFBC</Color>
    <Color x:Key="SystemAccentColorLight2">#B4FFC8</Color>
    <Color x:Key="SystemAccentColorLight3">#B4FFC8</Color>
</ResourceDictionary>
