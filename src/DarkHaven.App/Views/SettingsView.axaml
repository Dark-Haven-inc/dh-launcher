<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:Class="DarkHaven.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <DockPanel Margin="28,22">
        <Border DockPanel.Dock="Bottom" Classes="panel" CornerRadius="6" Padding="18,12" Margin="0,16,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding VersionLine}" Classes="mono dim" FontSize="10" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="Проверить обновления" Command="{Binding CheckForUpdatesCommand}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="22" MaxWidth="720">

                <StackPanel Spacing="12">
                    <TextBlock Text="ФАЙЛЫ" Classes="caps" />
                    <Grid ColumnDefinitions="140,*,Auto,Auto" RowDefinitions="Auto,14,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Папка игры" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DataDir}" IsReadOnly="True" />
                        <Button Grid.Row="0" Grid.Column="3" Classes="ghost" Content="Открыть" Margin="8,0,0,0"
                                Command="{Binding OpenDataDirCommand}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Кэш контента" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CacheSummary}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Grid.Row="2" Grid.Column="3" Classes="ghost" Content="Очистить" Margin="8,0,0,0"
                                Command="{Binding ClearContentCacheCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Status}" Classes="dim"
                               IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="ПОВЕДЕНИЕ" Classes="caps" />
                    <CheckBox Content="Обновлять контент автоматически" IsChecked="{Binding AutoUpdate}" />
                    <CheckBox Content="Сворачивать лаунчер при запуске игры" IsChecked="{Binding MinimizeOnLaunch}" />
                    <CheckBox IsChecked="{Binding VerboseLog}">
                        <TextBlock><Run Text="Подробный журнал" /><Run Foreground="#7C8DB0" Text=" — нужен, только если просят разработчики" /></TextBlock>
                    </CheckBox>
                    <CheckBox Content="Режим совместимости рендера (GLES2)" IsChecked="{Binding CompatMode}" />
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="ПОДКЛЮЧЕНИЕ" Classes="caps" />
                    <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,12,Auto,12,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Сервер авторизации" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AuthUrl}" />
                        <Button Grid.Row="0" Grid.Column="2" Classes="ghost" Content="По умолчанию" Margin="8,0,0,0"
                                Command="{Binding ResetAuthUrlCommand}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Сборки движка" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BuildsUrl}" />
                        <Button Grid.Row="2" Grid.Column="2" Classes="ghost" Content="По умолчанию" Margin="8,0,0,0"
                                Command="{Binding ResetBuildsUrlCommand}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Список регионов (URL)" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RegionsUrl}" Watermark="необязательно" />
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
