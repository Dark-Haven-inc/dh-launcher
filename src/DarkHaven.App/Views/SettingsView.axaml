<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:themes="using:DarkHaven.App.Themes"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <!-- One setting: its name on the left, the control on the right. -->
        <Style Selector="Grid.srow">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Grid.srow > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- One color in the theme's color editor: its name and value, then H, S, V. -->
        <DataTemplate DataType="vm:HsvSetting">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Classes="caps" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="mono dim" FontSize="10.5" Text="{Binding Hex}" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Width="12" Height="12" Background="{Binding Swatch}"
                            BorderBrush="{StaticResource DhBorderStrongBrush}" BorderThickness="1" />
                </Grid>
                <Grid ColumnDefinitions="12,*,24" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                    <TextBlock Classes="lbl" Text="H" VerticalAlignment="Center" />
                    <c:GradientSlider Grid.Column="1" Maximum="360" Value="{Binding Hue}" Track="{Binding HueTrack}" />
                    <TextBlock Grid.Column="2" Classes="mono" Text="{Binding HueText}" TextAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Classes="lbl" Text="S" VerticalAlignment="Center" />
                    <c:GradientSlider Grid.Row="1" Grid.Column="1" Value="{Binding Saturation}" Track="{Binding SaturationTrack}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono" Text="{Binding SaturationText}" TextAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Classes="lbl" Text="V" VerticalAlignment="Center" />
                    <c:GradientSlider Grid.Row="2" Grid.Column="1" Value="{Binding Value}" Track="{Binding ValueTrack}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="mono" Text="{Binding ValueText}" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Margin="20,16" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel>
                <Border Classes="cap"><TextBlock Classes="caps" Text="ВИД" /></Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="тема" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ComboBox Width="152" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="themes:Theme"><TextBlock Text="{Binding Title}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- The theme's colors; applied as the sliders move. -->
                            <Button Classes="icon" Content="&#xEB5C;" ToolTip.Tip="цвета" IsVisible="{Binding !IsRetro}">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="dh">
                                        <StackPanel Width="264" Margin="12" Spacing="16">
                                            <ContentControl Content="{Binding BaseColor}" />
                                            <ContentControl Content="{Binding ActiveColor}" />
                                            <Button Classes="small" Content="сбросить" HorizontalAlignment="Left"
                                                    Command="{Binding ResetColorsCommand}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- The retro theme's tube (Controls/CrtScreen.cs). -->
                <Border Classes="hair" IsVisible="{Binding IsRetro}">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="эффекты" />
                        <WrapPanel Grid.Column="1" ItemSpacing="16" LineSpacing="4" VerticalAlignment="Center" Margin="0,4">
                            <CheckBox Content="развёртка" IsChecked="{Binding RetroScanlines}" />
                            <CheckBox Content="свечение" IsChecked="{Binding RetroGlow}" />
                            <CheckBox Content="шум" IsChecked="{Binding RetroNoise}" />
                            <CheckBox Content="полоса" IsChecked="{Binding RetroBand}" />
                            <CheckBox Content="мерцание" IsChecked="{Binding RetroFlicker}" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel>
                <Border Classes="cap"><TextBlock Classes="caps" Text="ФАЙЛЫ" /></Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="папка" />
                        <TextBlock Grid.Column="1" Classes="mono" Foreground="{StaticResource DhTextBrush}" Text="{Binding DataDir}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Classes="icon" Content="&#xEA83;" ToolTip.Tip="открыть" Command="{Binding OpenDataDirCommand}" />
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="кэш контента" />
                        <TextBlock Grid.Column="1" Classes="mono" Foreground="{StaticResource DhTextBrush}" Text="{Binding CacheSummary}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="очистить" Command="{Binding ClearContentCacheCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="hair" Padding="0,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="проверить кэш" Command="{Binding VerifyContentCommand}" />
                        <Button Content="удалить старые движки" Command="{Binding CullEnginesCommand}" />
                        <Button Content="собрать логи" Command="{Binding CollectLogsCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <Border Classes="cap"><TextBlock Classes="caps" Text="ПОВЕДЕНИЕ" /></Border>
                <Border Classes="hair" Padding="0,8">
                    <StackPanel Spacing="8">
                        <CheckBox Content="обновлять контент автоматически" IsChecked="{Binding AutoUpdate}" />
                        <CheckBox Content="сворачивать при запуске игры" IsChecked="{Binding MinimizeOnLaunch}" />
                        <CheckBox Content="совместимость рендера (GLES2)" IsChecked="{Binding CompatMode}" />
                        <CheckBox Content="подробный журнал" IsChecked="{Binding VerboseLog}" />
                    </StackPanel>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="лимит загрузки" />
                        <Grid Grid.Column="1" Width="152" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBox Classes="mono" Text="{Binding DownloadLimit}" Watermark="—" Padding="8,4,44,4" />
                            <TextBlock Classes="mono dim" FontSize="10.5" Text="КБ/с" HorizontalAlignment="Right" Margin="0,0,8,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="обновления" />
                        <Button Grid.Column="1" Content="проверить" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Command="{Binding CheckForUpdatesCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Developers only: in a player's launcher these addresses can't be changed (AppServices.DevOverrides). -->
            <StackPanel IsVisible="{Binding ShowConnection}">
                <Border Classes="cap"><TextBlock Classes="caps" Text="ПОДКЛЮЧЕНИЕ" /></Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="авторизация" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                            <TextBox Classes="mono" Text="{Binding AuthUrl}" />
                            <Button Grid.Column="1" Classes="icon" Content="&#xEAE2;" ToolTip.Tip="по умолчанию" Command="{Binding ResetAuthUrlCommand}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="сборки движка" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                            <TextBox Classes="mono" Text="{Binding BuildsUrl}" />
                            <Button Grid.Column="1" Classes="icon" Content="&#xEAE2;" ToolTip.Tip="по умолчанию" Command="{Binding ResetBuildsUrlCommand}" />
                        </Grid>
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="список регионов" />
                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding RegionsUrl}" Watermark="—" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="платформа" />
                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding PlatformUrl}" Watermark="https://api.dark-haven.xyz" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel>
                <Border Classes="cap"><TextBlock Classes="caps" Text="DISCORD" /></Border>
                <Border Classes="hair">
                    <Grid Classes="srow" ColumnDefinitions="160,*" ColumnSpacing="12">
                        <TextBlock Text="ID приложения" />
                        <TextBox Grid.Column="1" Classes="mono" Text="{Binding DiscordAppId}" Watermark="—" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
