<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:views="using:DarkHaven.App.Views"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.FriendsPanel"
             x:DataType="vm:FriendsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.fr">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0,4,0" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Unfriend only shows on the hovered row. -->
        <Style Selector="Border.fr Button.rm">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.fr:pointerover Button.rm, Border.fr Button.rm.armed">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.who">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.who:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.who:pointerover TextBlock.nm">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Height="28" Padding="12,0" Classes="hair">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="ДРУЗЬЯ" Classes="caps" />
                <TextBlock Grid.Column="1" Text="{Binding OnlineSummary}" Classes="caps" />
            </Grid>
        </Border>

        <!-- Add by username -->
        <StackPanel DockPanel.Dock="Bottom" Margin="12,8" Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBox Text="{Binding AddName}" Watermark="Ник" MaxLength="64">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendRequestCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="icon" Content="&#xEA60;" ToolTip.Tip="Добавить"
                        Command="{Binding SendRequestCommand}" />
            </Grid>
            <TextBlock Text="{Binding AddStatus}" Classes.dim="{Binding !AddFailed}" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding HasAddStatus}" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel>
                <!-- Incoming requests -->
                <ItemsControl ItemsSource="{Binding Incoming}" IsVisible="{Binding HasIncoming}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FriendItemViewModel">
                            <Border Classes="fr">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                    <TextBlock Text="{Binding Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Classes="primary small" Content="Принять"
                                            Command="{Binding $parent[UserControl].((vm:FriendsViewModel)DataContext).AcceptCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="2" Classes="link icon" Content="&#xEA76;" ToolTip.Tip="Отклонить"
                                            Width="20" Height="20"
                                            Command="{Binding $parent[UserControl].((vm:FriendsViewModel)DataContext).DismissCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Friends: playing first, then in the launcher, then offline (the platform sorts) -->
                <ItemsControl ItemsSource="{Binding Friends}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FriendItemViewModel">
                            <Border Classes="fr">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                    <c:StatusGlyph IsOnline="{Binding IsPlaying}" IsOffline="{Binding !Online}"
                                                   Foreground="{Binding Online, Converter={x:Static vm:BoolBrush.OnlineOffline}}" />
                                    <Button Grid.Column="1" Classes="who" ToolTip.Tip="{Binding Status}">
                                        <Button.Flyout>
                                            <Flyout Placement="LeftEdgeAlignedTop" FlyoutPresenterClasses="dh">
                                                <views:ProfileCard Width="280" DataContext="{Binding Card}" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="nm" Text="{Binding Username}" VerticalAlignment="Center"
                                                       Foreground="{Binding Online, Converter={x:Static vm:BoolBrush.OnlineOffline}}" />
                                            <TextBlock Text="{Binding ServerName}" Classes="dim" FontSize="10.5" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" IsVisible="{Binding IsPlaying}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Classes="small" Content="Зайти" IsVisible="{Binding IsPlaying}"
                                            Command="{Binding $parent[UserControl].((vm:FriendsViewModel)DataContext).JoinCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Classes="link rm" Classes.armed="{Binding ConfirmingRemove}"
                                            Content="{Binding RemoveLabel}" FontFamily="{StaticResource DhMono}" FontSize="10.5"
                                            ToolTip.Tip="Удалить из друзей" VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].((vm:FriendsViewModel)DataContext).UnfriendCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Outgoing requests -->
                <ItemsControl ItemsSource="{Binding Outgoing}" IsVisible="{Binding HasOutgoing}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FriendItemViewModel">
                            <Border Classes="fr">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <c:StatusGlyph Kind="q" Foreground="{StaticResource DhTextFaintBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Username}" Classes="faint" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="ждёт ответа" />
                                    <Button Grid.Column="2" Classes="link icon" Content="&#xEA76;" ToolTip.Tip="Отменить заявку"
                                            Width="20" Height="20"
                                            Command="{Binding $parent[UserControl].((vm:FriendsViewModel)DataContext).DismissCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
