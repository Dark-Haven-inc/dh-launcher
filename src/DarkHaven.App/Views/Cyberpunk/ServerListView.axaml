<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             xmlns:t="using:DarkHaven.App.Themes"
             xmlns:c="using:DarkHaven.App.Controls"
             x:Class="DarkHaven.App.Views.Cyberpunk.ServerListView"
             x:DataType="vm:ServerListViewModel">
    <!-- СЕРВЕРЫ as a net scan: a prompt to search, the direct address, the filters as toggles; each network
         a block under a "// LABEL" tag, its servers rows with a status bar down the edge, the name (and its
         next launch in yellow), [tags], the ping as signal bars, the head-count as a meter, a pink jack-in.
         The listing request is a cut-corner panel. The map mode is the neon net with the server's dossier. -->

    <UserControl.Styles>
        <Style Selector="Button.fav">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource DhMono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.fav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource DhActiveBrush}" />
        </Style>
        <Style Selector="Border.entry">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.entry:pointerover">
            <Setter Property="Background" Value="{StaticResource DhBgHoverBrush}" />
        </Style>
        <Style Selector="Border.entry.off TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DhTextFaintBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="22,16,22,14">
        <!-- Search and a direct address -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,16,200,Auto" ColumnSpacing="6">
            <Grid>
                <TextBox Classes="mono" Watermark="поиск по сети" Text="{Binding Search}" Padding="26,4,8,4" />
                <TextBlock Classes="mono" Text="&gt;" Foreground="{StaticResource DhActiveBrush}" FontSize="13" Margin="10,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <TextBox Grid.Column="2" Classes="mono" Watermark="ss14://" Text="{Binding DirectAddress}" />
            <Button Grid.Column="3" Content="подключиться" Command="{Binding ConnectDirectCommand}" />
        </Grid>

        <!-- Filters, and the tools at the right -->
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" Margin="12,0,0,0">
                <ToggleButton Classes="chip glyph" Content="&#xEC05;" ToolTip.Tip="карта" IsChecked="{Binding MapView}" />
                <Button Classes="icon" Content="&#xEB37;" ToolTip.Tip="обновить" Command="{Binding RefreshCommand}" />
                <Button Command="{Binding ToggleApplyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="&#xEA60;" FontSize="11" />
                        <TextBlock Text="разместить" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <WrapPanel ItemSpacing="6" LineSpacing="6">
                <TextBlock Classes="unit" Text="СКРЫТЬ" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ToggleButton Classes="chip" Content="пустые" IsChecked="{Binding HideEmpty}" />
                <ToggleButton Classes="chip" Content="полные" IsChecked="{Binding HideFull}" />
                <ToggleButton Classes="chip" Content="18+" IsChecked="{Binding Hide18Plus}" />
                <ToggleButton Classes="chip" Content="избранное" IsChecked="{Binding FavoritesOnly}" />
                <ToggleButton Classes="chip" Content="А–Я" IsChecked="{Binding SortByName}" />
                <TextBlock Classes="unit" Text="RP" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ToggleButton Classes="chip" Content="нет" IsChecked="{Binding RpNone}" />
                <ToggleButton Classes="chip" Content="лёгкий" IsChecked="{Binding RpLow}" />
                <ToggleButton Classes="chip" Content="средний" IsChecked="{Binding RpMed}" />
                <ToggleButton Classes="chip" Content="высокий" IsChecked="{Binding RpHigh}" />
            </WrapPanel>
        </DockPanel>

        <!-- The listing request -->
        <c:Chamfer DockPanel.Dock="Top" Cut="14" Background="#CC0F0F1B" BorderBrush="{StaticResource CyberLineBrush}" Padding="20,14,20,16" Margin="0,14,0,0"
                   IsVisible="{Binding ShowApply}">
            <StackPanel Spacing="10">
                <TextBlock Classes="tag pink" Text="// ЗАЯВКА НА РАЗМЕЩЕНИЕ" />
                <TextBlock Classes="prose" FontSize="12.5" IsVisible="{Binding !CanApply}" Text="Войдите в аккаунт, чтобы подать заявку." />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto" IsVisible="{Binding CanApply}">
                    <TextBlock Classes="unit" Text="НАЗВАНИЕ" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ApplyName}" MaxLength="60" />
                    <TextBlock Grid.Row="2" Classes="unit" Text="АДРЕС" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Classes="mono" Watermark="ss14://адрес:порт" Text="{Binding ApplyAddress}" MaxLength="200" />
                    <TextBlock Grid.Row="4" Classes="unit" Text="О СЕРВЕРЕ" VerticalAlignment="Top" Margin="0,8,0,0" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ApplyDescription}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="56" MaxLength="500" VerticalContentAlignment="Top" />
                    <TextBlock Grid.Row="6" Classes="unit" Text="КОНТАКТ" VerticalAlignment="Center" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ApplyContact}" MaxLength="100" />
                </Grid>
                <Button Classes="primary" HorizontalAlignment="Right" Content="ОТПРАВИТЬ" IsVisible="{Binding CanApply}"
                        Command="{Binding SubmitApplicationCommand}" IsEnabled="{Binding !ApplyBusy}" />
                <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource DhWarnBrush}" Text="{Binding ApplyStatus}" TextWrapping="Wrap"
                           IsVisible="{Binding ApplyStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <StackPanel IsVisible="{Binding HasMyApplications}" Margin="0,4,0,0">
                    <Border Classes="cap"><TextBlock Classes="tag" Text="// МОИ ЗАЯВКИ" /></Border>
                    <ItemsControl ItemsSource="{Binding MyApplications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MyApplicationRow">
                                <Border Classes="hair" Padding="0,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <TextBlock>
                                                <Run Text="{Binding Name}" FontFamily="{StaticResource DhTech}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding StatusText, Converter={x:Static t:TextBits.Upper}}" FontFamily="{StaticResource DhTech}" FontSize="10.5" Foreground="{StaticResource DhActiveBrush}" /><Run Text="  " /><Run Text="{Binding WhenText}" FontFamily="{StaticResource DhMono}" FontSize="10.5" Foreground="{StaticResource DhTextFaintBrush}" />
                                            </TextBlock>
                                            <TextBlock Classes="prose" FontSize="12" Text="{Binding Note}"
                                                       IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <!-- A server that runs at set times: its next launch (the countdown, favourites' alerts). -->
                                            <StackPanel Spacing="4" Margin="0,2,0,0" IsVisible="{Binding CanSchedule}">
                                                <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource DhWarnBrush}" Text="{Binding LaunchNow, Converter={x:Static vm:Lowercase.Instance}}" TextWrapping="Wrap" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Classes="unit" Text="СЛЕДУЮЩИЙ ЗАПУСК" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                    <CalendarDatePicker SelectedDate="{Binding LaunchDate}" Watermark="дата" Width="134" Margin="0,0,6,4" />
                                                    <TimePicker SelectedTime="{Binding LaunchTime}" ClockIdentifier="24HourClock" MinuteIncrement="5" Margin="0,0,6,4" />
                                                    <TextBox Text="{Binding LaunchNote}" Watermark="подпись: ивент, карта" MaxLength="100" Width="190" Margin="0,0,6,4" />
                                                    <Button Classes="small" Content="таймер" Margin="0,0,6,4"
                                                            Command="{Binding $parent[ItemsControl].((vm:ServerListViewModel)DataContext).SaveLaunchCommand}" CommandParameter="{Binding}" />
                                                    <Button Classes="link" Content="убрать" Margin="0,0,0,4" VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((vm:ServerListViewModel)DataContext).ClearLaunchCommand}" CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="link" Content="отозвать" VerticalAlignment="Top" IsVisible="{Binding CanWithdraw}"
                                                Command="{Binding $parent[ItemsControl].((vm:ServerListViewModel)DataContext).WithdrawApplicationCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </c:Chamfer>

        <Panel DockPanel.Dock="Top" Margin="0,12,0,0" Height="3">
            <ProgressBar Classes="meter" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
        </Panel>
        <TextBlock DockPanel.Dock="Top" Classes="mono" FontSize="11" Foreground="{StaticResource DhDangerBrush}" Text="{Binding Error}" Margin="0,6,0,0"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Top" Classes="tag" Margin="0,6,0,0" IsVisible="{Binding IsEmpty}" Text="// СЕТЬ ПУСТА" />

        <Panel Margin="0,4,0,0">
            <!-- The net -->
            <Grid ColumnDefinitions="*,290" IsVisible="{Binding MapView}" Margin="-22,0,-22,-14">
                <c:FlatMap x:Name="Map" ItemsSource="{Binding MapNodes}" SelectedItem="{Binding SelectedServer}" />
                <Border Grid.Column="1" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1,0,0,0" Background="#990A0A12">
                    <ScrollViewer IsVisible="{Binding SelectedServer, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Margin="18,16" Spacing="12">
                            <TextBlock Classes="tag pink" Text="{Binding SelectedServer.RegionLabel, Converter={x:Static t:TextBits.Upper}, StringFormat='// {0}'}"
                                       IsVisible="{Binding SelectedServer.RegionLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="big" FontSize="22" Text="{Binding SelectedServer.Name}" TextWrapping="Wrap" />
                            <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource DhTextDimBrush}" Text="{Binding SelectedServer.Address}" TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding SelectedServer.VisibleTags}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource DhCyanBrush}" Text="{Binding StringFormat='[{0}]'}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,12,Auto">
                                <Border Classes="cell">
                                    <StackPanel Spacing="2"><TextBlock Classes="readout" FontSize="13" Text="{Binding SelectedServer.StateText}" /><TextBlock Classes="unit" Text="СТАТУС" /></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="cell">
                                    <StackPanel Spacing="2"><TextBlock Classes="readout" FontSize="13" Text="{Binding SelectedServer.Population}" /><TextBlock Classes="unit" Text="ИГРОКИ" /></StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="cell"
                                        IsVisible="{Binding SelectedServer.RoundInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <StackPanel Spacing="2"><TextBlock Classes="readout" FontSize="13" Text="{Binding SelectedServer.RoundInfo}" /><TextBlock Classes="unit" Text="РАУНД" /></StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource DhWarnBrush}" Text="{Binding SelectedServer.LaunchText, Converter={x:Static vm:Lowercase.Instance}}"
                                       IsVisible="{Binding SelectedServer.HasLaunch}" TextWrapping="Wrap" />
                            <Button Classes="jack" HorizontalAlignment="Stretch" Command="{Binding SelectedServer.ConnectCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="icon" Text="&#xEB2C;" FontSize="14" />
                                    <TextBlock Text="ИГРАТЬ" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding SelectedServer.SlotLabel, Converter={x:Static vm:Lowercase.Instance}}" Command="{Binding SelectedServer.WaitForSlotCommand}"
                                    IsVisible="{Binding SelectedServer.CanWaitForSlot}" />
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SelectedServer.ToggleFavoriteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" FontSize="11" Text="{Binding SelectedServer.IsFavorite, Converter={x:Static vm:FavGlyph.Instance}}" />
                                    <TextBlock Text="избранное" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- The scan, network by network -->
            <ScrollViewer IsVisible="{Binding !MapView}" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="18" Margin="0,6,0,0" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerGroupViewModel">
                            <StackPanel>
                                <Border Classes="cap">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="tag" Text="{Binding Label, Converter={x:Static t:TextBits.Upper}, StringFormat='// {0}'}" />
                                        <TextBlock Grid.Column="1" Classes="mono" FontSize="10.5" Foreground="{StaticResource DhTextDimBrush}" Text="{Binding SummaryLine}" />
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Servers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ServerRowViewModel">
                                            <Border Classes="entry" Classes.off="{Binding IsOffline}">
                                                <Grid ColumnDefinitions="3,18,*,Auto,18,64,64" ColumnSpacing="10">
                                                    <Border Classes="status" Classes.on="{Binding IsOnline}" Classes.full="{Binding IsFull}" Classes.down="{Binding IsOffline}" />
                                                    <Button Grid.Column="1" Classes="fav" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="избранное" VerticalAlignment="Center"
                                                            Content="{Binding IsFavorite, Converter={x:Static vm:FavGlyph.Instance}}"
                                                            Foreground="{Binding IsFavorite, Converter={x:Static vm:BoolBrush.TextOrDim}}" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,4">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="mono" FontSize="10.5" Foreground="{StaticResource DhWarnBrush}"
                                                                   Text="{Binding LaunchText, Converter={x:Static vm:Lowercase.Instance}}" IsVisible="{Binding HasLaunch}" />
                                                    </StackPanel>
                                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding VisibleTags}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock Classes="mono" FontSize="10" Foreground="{StaticResource DhTextDimBrush}" Text="{Binding StringFormat='[{0}]'}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <c:SignalBars Grid.Column="4" Ping="{Binding Entry.PingMs}" ToolTip.Tip="{Binding PingText}" />
                                                    <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="3">
                                                        <TextBlock Classes="mono" FontSize="10.5" Text="{Binding Population}" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource DhCyanBrush}" />
                                                        <ProgressBar Classes="meter" Value="{Binding Players}" Maximum="{Binding Entry.SoftMaxPlayers}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="6" Classes="small primary" Content="ИГРАТЬ" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Command="{Binding ConnectCommand}" IsVisible="{Binding IsOnline}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
