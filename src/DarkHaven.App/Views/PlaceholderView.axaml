<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DarkHaven.App.ViewModels"
             x:CompileBindings="False"
             x:Class="DarkHaven.App.Views.PlaceholderView">
    <TextBlock Text="{Binding Message, Converter={x:Static vm:Lowercase.Instance}}" Classes="dim" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"
               VerticalAlignment="Center" HorizontalAlignment="Center" />
</UserControl>
