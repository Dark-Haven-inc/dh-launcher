<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:DarkHaven.App.Controls">
    <!-- The legacy layout: the rounded blue HUD from before the monochrome redesign, as it was.
         Colors come from the palette (Themes/Palettes). -->
    <Styles.Resources>
        <FontFamily x:Key="DhMono">Consolas, 'Cascadia Mono', 'DejaVu Sans Mono', monospace</FontFamily>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource DhBgBrush}" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DhTextBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource DhTextBrush}" />
    </Style>
    <Style Selector="TextBlock.caps">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        <Setter Property="LetterSpacing" Value="1.5" />
    </Style>
    <Style Selector="TextBlock.dim">
        <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource DhMono}" />
    </Style>

    <!-- Bottom navigation tab -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="{StaticResource DhBgElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="22,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DhBgHoverBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource DhTextBrush}" />
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Background" Value="{StaticResource DhAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.tab.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DhAccentBrush}" />
        <Setter Property="TextBlock.Foreground" Value="White" />
    </Style>

    <!-- Top-bar pill button -->
    <Style Selector="Button.pill">
        <Setter Property="Background" Value="{StaticResource DhAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DhBgHoverBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource DhTextBrush}" />
    </Style>
    <!-- alias kept for the not-yet-restyled views -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DhTextDimBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DhBgHoverBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource DhTextBrush}" />
    </Style>

    <!-- Big primary action -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource DhAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource DhAccentBrightBrush}" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource DhDangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource DhBgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Dropdown panels (the notifications bell): same surface as a card, no Fluent padding. -->
    <Style Selector="FlyoutPresenter.dh">
        <Setter Property="Background" Value="{StaticResource DhBgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource DhBgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource DhBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DhBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DhTextBrush}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource DhAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource DhBgHoverBrush}" />
    </Style>

    <Style Selector="c|OnlineChart">
        <Setter Property="Rounded" Value="True" />
        <Setter Property="Surface" Value="{StaticResource DhBgElevated}" />
    </Style>
</Styles>
