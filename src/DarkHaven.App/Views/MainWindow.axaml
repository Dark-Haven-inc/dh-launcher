<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DarkHaven.App.ViewModels"
        xmlns:views="using:DarkHaven.App.Views"
        xmlns:c="using:DarkHaven.App.Controls"
        x:Class="DarkHaven.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Frontier 15 Launcher" Width="960" Height="600"
        MinWidth="880" MinHeight="560"
        Icon="/Assets/icon.ico"
        SystemDecorations="None"
        Background="{StaticResource DhBgBrush}">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="vm:RegionsViewModel"><views:RegionsView /></DataTemplate>
        <DataTemplate DataType="vm:ServerListViewModel"><views:ServerListView /></DataTemplate>
        <DataTemplate DataType="vm:MonitoringViewModel"><views:MonitoringView /></DataTemplate>
        <DataTemplate DataType="vm:LocalViewModel"><views:LocalView /></DataTemplate>
        <DataTemplate DataType="vm:BanListViewModel"><views:BanListView /></DataTemplate>
        <DataTemplate DataType="vm:NewsViewModel"><views:NewsView /></DataTemplate>
        <DataTemplate DataType="vm:AdminViewModel"><views:AdminView /></DataTemplate>
        <DataTemplate DataType="vm:AccountViewModel"><views:AccountView /></DataTemplate>
        <DataTemplate DataType="vm:ProfileViewModel"><views:ProfileView /></DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="vm:ConnectingViewModel"><views:ConnectingView /></DataTemplate>
        <DataTemplate DataType="vm:PaletteViewModel"><views:PaletteView /></DataTemplate>
    </Window.DataTemplates>

    <Border BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="1">
    <Panel>
        <DockPanel>
            <!-- Top bar. With no OS frame it is the title bar too: drag to move, double-click to maximize. -->
            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="32" Background="{StaticResource DhBgBrush}"
                    BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="FRONTIER 15" Margin="16,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource DhMono}" FontWeight="Medium" FontSize="10.5" LetterSpacing="2.3" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="top" ToolTip.Tip="Уведомления" IsVisible="{Binding Notifications.IsAvailable}">
                            <Panel>
                                <TextBlock Classes="icon" Text="&#xEAA2;" FontSize="13" />
                                <Border Width="5" Height="5" Background="{StaticResource DhTextBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-3,0"
                                        IsVisible="{Binding Notifications.HasUnread}" />
                            </Panel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="dh">
                                    <views:NotificationsPanel DataContext="{Binding Notifications}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Classes="top" Command="{Binding OpenAccountCommand}"
                                Classes.active="{Binding IsAccountPage}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="&#xEB99;" FontSize="13" />
                                <TextBlock Text="{Binding AccountName, TargetNullValue='Гость', FallbackValue='Гость'}"
                                           FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                            <Button Classes="wc" ToolTip.Tip="Свернуть" Click="OnMinimize">
                                <Path Data="M0,0.5 H8" Width="8" Height="1" />
                            </Button>
                            <Button Classes="wc close" ToolTip.Tip="Закрыть" Click="OnClose">
                                <Path Data="M0.5,0.5 L8.5,8.5 M8.5,0.5 L0.5,8.5" Width="9" Height="9" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Left rail: navigation, and the version block at the bottom. -->
            <Border DockPanel.Dock="Left" Width="144" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource DhBgPanelBrush}"
                            BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="lbl" Text="ЛАУНЧЕР" LetterSpacing="0.8" />
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="10" Text="{Binding LauncherVersion}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="lbl" Text="ДВИЖОК" LetterSpacing="0.8" />
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="10" Text="{Binding EngineVersion}" />
                            </Grid>
                            <Button Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="0,4,0,0" BorderBrush="{StaticResource DhActiveLineBrush}"
                                    Content="{Binding UpdateButtonText}" Command="{Binding UpdateActionCommand}"
                                    IsVisible="{Binding ShowUpdateButton}" />
                            <TextBlock Classes="mono dim" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"
                                       Text="{Binding UpdateStatusText}" IsVisible="{Binding ShowUpdateStatus}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,8,0,0">
                        <Button Classes="navitem" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Home}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Home}}">
                            <StackPanel Orientation="Horizontal"><Border Classes="marker" Width="4" Height="4" Background="{StaticResource DhActiveLineBrush}" Margin="-8,0,4,0" /><TextBlock Text="Главная" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
                        </Button>
                        <Button Classes="navitem" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Regions}"
                                Classes.active="{Binding IsRegionsPage}">
                            <StackPanel Orientation="Horizontal"><Border Classes="marker" Width="4" Height="4" Background="{StaticResource DhActiveLineBrush}" Margin="-8,0,4,0" /><TextBlock Text="Регионы" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
                        </Button>
                        <Button Classes="navitem" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Servers}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Servers}}">
                            <StackPanel Orientation="Horizontal"><Border Classes="marker" Width="4" Height="4" Background="{StaticResource DhActiveLineBrush}" Margin="-8,0,4,0" /><TextBlock Text="Серверы" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
                        </Button>
                        <Button Classes="navitem" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Monitoring}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Monitoring}}">
                            <StackPanel Orientation="Horizontal"><Border Classes="marker" Width="4" Height="4" Background="{StaticResource DhActiveLineBrush}" Margin="-8,0,4,0" /><TextBlock Text="Мониторинг" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
                        </Button>
                        <Button Classes="navitem" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Local}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Local}}">
                            <StackPanel Orientation="Horizontal"><Border Classes="marker" Width="4" Height="4" Background="{StaticResource DhTextBrush}" Margin="-8,0,4,0" /><TextBlock Text="Локалка" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
                        </Button>
                        <Button Classes="navitem" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.News}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.News}}">
                            <StackPanel Orientation="Horizontal"><Border Classes="marker" Width="4" Height="4" Background="{StaticResource DhActiveLineBrush}" Margin="-8,0,4,0" /><TextBlock Text="Новости" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
                        </Button>
                        <Button Classes="navitem" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Settings}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Settings}}">
                            <StackPanel Orientation="Horizontal"><Border Classes="marker" Width="4" Height="4" Background="{StaticResource DhActiveLineBrush}" Margin="-8,0,4,0" /><TextBlock Text="Настройки" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
                        </Button>
                        <Button Classes="navitem" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:NavPage.Admin}" IsVisible="{Binding Admin.CanSeeAdmin}"
                                Classes.active="{Binding Page, Converter={x:Static vm:EnumMatch.Instance}, ConverterParameter={x:Static vm:NavPage.Admin}}">
                            <StackPanel Orientation="Horizontal"><Border Classes="marker" Width="4" Height="4" Background="{StaticResource DhActiveLineBrush}" Margin="-8,0,4,0" /><TextBlock Text="Админ" Foreground="{Binding $parent[Button].Foreground}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- A watched region came back, or a slot opened: one line on top of the page. -->
            <Border DockPanel.Dock="Top" Height="32" Padding="20,0" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,0,0,1"
                    Background="{StaticResource DhBgPanelBrush}" IsVisible="{Binding ShowRegionBanner}">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <c:StatusGlyph Kind="on" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding RegionBannerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary small" Content="ИГРАТЬ" Command="{Binding ConnectOnlineRegionCommand}" />
                        <Button Classes="small" Content="Позже" Command="{Binding DismissRegionBannerCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Top" Height="32" Padding="20,0" BorderBrush="{StaticResource DhBorderBrush}" BorderThickness="0,0,0,1"
                    Background="{StaticResource DhBgPanelBrush}" IsVisible="{Binding ShowSlotWaitBanner}">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <c:StatusGlyph Kind="full" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding SlotWaitBannerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="small" Content="Не ждать" Command="{Binding CancelSlotWaitCommand}" />
                </Grid>
            </Border>

            <ContentControl Content="{Binding Current}" />
        </DockPanel>

        <!-- Connecting: a dialog over the dimmed page. -->
        <Border Margin="0,32,0,0" Background="{StaticResource DhScrimBrush}"
                IsVisible="{Binding Connecting, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding Connecting}" />
        </Border>

        <!-- Quick switcher (Ctrl+K). -->
        <Border Margin="0,32,0,0" Background="{StaticResource DhScrimBrush}" PointerPressed="OnPaletteBackdropPressed"
                IsVisible="{Binding Palette, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding Palette}" />
        </Border>

        <!-- Resize grips along the edges (there is no OS frame to grab). -->
        <Border Classes="grip" Tag="N" Height="4" VerticalAlignment="Top" Cursor="TopSide" />
        <Border Classes="grip" Tag="S" Height="4" VerticalAlignment="Bottom" Cursor="BottomSide" />
        <Border Classes="grip" Tag="W" Width="4" HorizontalAlignment="Left" Cursor="LeftSide" />
        <Border Classes="grip" Tag="E" Width="4" HorizontalAlignment="Right" Cursor="RightSide" />
        <Border Classes="grip" Tag="NW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="TopLeftCorner" />
        <Border Classes="grip" Tag="NE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="TopRightCorner" />
        <Border Classes="grip" Tag="SW" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="BottomLeftCorner" />
        <Border Classes="grip" Tag="SE" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner" />
    </Panel>
    </Border>
</Window>
